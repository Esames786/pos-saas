# DEV EDGE INSTANCE — a branch_server-role copy of THIS worktree served by `php artisan serve --env=edgedev` against a
# disposable, production-shaped LOCAL database seeded by tests/MySql/EdgeDevInstanceSeedMySqlTest (tools/edge-dev-instance).
# Purpose: browser proofs (tools/edge-browser-proof) and W1–W5 development WITHOUT touching the P5C LAB appliance or any tenant.
# The EDGE_LOCAL_APP_KEY is generated per machine by tools/edge-dev-instance/serve.sh (never committed; .env.edgedev is ignored).
APP_NAME="Bingoo Edge DEV"
APP_ENV=local
APP_DEBUG=true
APP_ROLE=branch_server
APP_URL=http://127.0.0.1:8095
APP_TIMEZONE=Asia/Karachi
EDGE_LOCAL_APP_KEY=
LOG_CHANNEL=single
LOG_LEVEL=debug

# master connection is REQUIRED by config but never used by a branch_server page — point it at the worktree's TEST master DB
DB_CONNECTION=master
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_test_master_edgewt
DB_USERNAME=root
DB_PASSWORD=

TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_USERNAME=root
TENANT_DB_PASSWORD=

# the appliance-local database (bingoo_edge_* names are the only ones EdgeLocalDatabase accepts) — dev-seeded, disposable
EDGE_DB_HOST=127.0.0.1
EDGE_DB_PORT=3306
EDGE_DB_DATABASE=bingoo_edge_devtest_local
EDGE_DB_USERNAME=root
EDGE_DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
