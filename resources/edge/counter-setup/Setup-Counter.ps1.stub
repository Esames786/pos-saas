# Bingoo POS - COUNTER SETUP for: {{BINGOO_BRANCH_LABEL_TEXT}}
# Generated by the Bingoo Cloud on {{BINGOO_GENERATED_AT}} for the Branch Server {{BINGOO_EDGE_HOST}} ({{BINGOO_EDGE_IP}}, port {{BINGOO_EDGE_PORT}}).
#
# Run it on every cashier PC and on the owner's laptop. It is safe to run again at any time.
#   Right-click this file -> "Run with PowerShell" -> click YES on the Windows prompt.
#   (or in a PowerShell window:  powershell -ExecutionPolicy Bypass -File .\{{BINGOO_FILE_NAME}})
#
# What it does (nothing else is changed):
#   1. trusts the branch certificate (the PUBLIC CA certificate embedded below) in this PC's Trusted Root store
#   2. writes the hosts line   {{BINGOO_HOSTS_LINE}}
#   3. puts three shortcuts with the Bingoo icon on the desktop of every user:
#        BINGOO Online / BINGOO Offline / Branch Server Status
#   4. checks the Branch Server by name and by IP with FULL certificate validation (never bypassed)
# This file holds only public addresses and the public certificate - no login, no PIN, no private key.
#
# Roman Urdu: Yeh file har cashier PC aur owner ke laptop par chalayein (dobara chalana bhi theek hai).
#   File par right-click -> "Run with PowerShell" -> Windows ke sawal par YES dabayein.

param(
    [switch]$Elevated,  # set by this script when it starts itself again as administrator
    [switch]$NoPause    # do not wait for Enter at the end (unattended / remote runs)
)

$ErrorActionPreference = 'Stop'

$BranchLabel  = '{{BINGOO_BRANCH_LABEL}}'
$EdgeIp       = '{{BINGOO_EDGE_IP}}'
$EdgeHost     = '{{BINGOO_EDGE_HOST}}'
$EdgePort     = {{BINGOO_EDGE_PORT}}
$HostsLine    = '{{BINGOO_HOSTS_LINE}}'
$LanHint      = '{{BINGOO_LAN_HINT}}'
$UrlOnline    = '{{BINGOO_URL_ONLINE}}'
$UrlOffline   = '{{BINGOO_URL_OFFLINE}}'
$UrlStatus    = '{{BINGOO_URL_STATUS}}'
$CheckByName  = '{{BINGOO_CHECK_BY_NAME}}'
$CheckByIp    = '{{BINGOO_CHECK_BY_IP}}'
$CaName       = '{{BINGOO_CA_NAME}}'
$CaThumbprint = '{{BINGOO_CA_SHA1}}'
$CaSha256     = '{{BINGOO_CA_SHA256}}'
$CaPem = @'
{{BINGOO_CA_PEM}}
'@
# The Bingoo logo as a 128 px icon (public branding asset, base64).
$IconB64 = '{{BINGOO_ICON_B64}}'

$LogDir = Join-Path $env:ProgramData 'BingooPOS\logs'

# ---- helpers --------------------------------------------------------------------------------------------------------

function Write-Say {
    param([string]$English, [string]$Urdu, [string]$Color = 'Gray')
    Write-Host $English -ForegroundColor $Color
    if ($Urdu) { Write-Host ('   ' + $Urdu) -ForegroundColor $Color }
}

function Wait-BeforeClose {
    if ($NoPause) { return }
    Write-Host ''
    Write-Say 'Press Enter to close this window.' 'Window band karne ke liye Enter dabayein.' 'White'
    try { [void](Read-Host) } catch { }
}

function Test-IsAdministrator {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    return ([Security.Principal.WindowsPrincipal]$identity).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

# ---- 0. unblock + administrator rights ------------------------------------------------------------------------------

# A file downloaded from the internet is "blocked" by Windows; unblock this one so it runs without extra warnings.
if ($PSCommandPath) {
    try { Unblock-File -LiteralPath $PSCommandPath -ErrorAction Stop } catch { }
}

Write-Host ''
Write-Host ('==== Bingoo counter setup - ' + $BranchLabel + ' ====') -ForegroundColor Cyan

if (-not (Test-IsAdministrator)) {
    if ($Elevated) {
        Write-Say 'Windows started this setup again, but it still has no administrator rights. Nothing was changed.' 'Windows ne setup dobara chalaya, lekin administrator ki ijazat phir bhi nahin mili. Kuch bhi tabdeel nahin hua.' 'Red'
        Wait-BeforeClose
        exit 1
    }
    if (-not $PSCommandPath) {
        Write-Say 'Save this file on the PC first, then right-click it and choose "Run with PowerShell".' 'Pehle yeh file PC par save karein, phir us par right-click karke "Run with PowerShell" chunein.' 'Red'
        Wait-BeforeClose
        exit 1
    }
    Write-Say 'This setup needs administrator rights: it trusts the branch certificate and edits the hosts file for ALL users of this PC.' 'Is setup ko administrator ki ijazat chahiye: yeh branch certificate trust karta hai aur is PC ke SAB users ke liye hosts file badalta hai.' 'Yellow'
    Write-Say 'Windows will now ask "Do you want to allow this app to make changes to your device?" - click YES.' 'Ab Windows poochay ga "Do you want to allow this app to make changes to your device?" - YES dabayein.' 'Yellow'
    Write-Say 'If Windows asks for a user name instead, this Windows user is NOT an administrator: ask the shop owner or the IT person to sign in there with an ADMINISTRATOR account. (A POS PIN does not work there.)' 'Agar Windows user name maange, to yeh Windows user administrator NAHIN hai: dukaan ke owner ya IT wale se wahan ADMINISTRATOR account se sign in karwayein. (POS ka PIN wahan kaam nahin karta.)' 'Yellow'
    $argLine = '-NoProfile -ExecutionPolicy Bypass -File "' + $PSCommandPath + '" -Elevated'
    if ($NoPause) { $argLine += ' -NoPause' }
    try {
        $child = Start-Process -FilePath 'powershell.exe' -Verb RunAs -ArgumentList $argLine -PassThru -ErrorAction Stop
    } catch {
        Write-Host ''
        Write-Say 'Administrator permission was not given (NO was clicked, or no administrator account was entered). Nothing was changed.' 'Administrator ki ijazat nahin mili (NO dabaya gaya, ya administrator account nahin diya gaya). Kuch bhi tabdeel nahin hua.' 'Red'
        Write-Say 'Run this file again and click YES, or ask the shop owner / IT person to sign in as administrator.' 'Yeh file dobara chalayein aur YES dabayein, ya owner / IT wale se administrator sign in karwayein.' 'Red'
        Wait-BeforeClose
        exit 1
    }
    Write-Say 'The setup continues in the new administrator window - read the result there.' 'Setup naye administrator window mein chal raha hai - natija wahin parhein.' 'Green'
    $childCode = 0
    try { $child.WaitForExit(); $childCode = [int]$child.ExitCode } catch { $childCode = 0 }
    if ($childCode -ne 0) {
        Write-Host ''
        Write-Say ('The administrator window finished with a problem (code ' + $childCode + '). If it closed too fast to read, see the log in ' + $LogDir + ', or copy this file to the Desktop (not a network drive) and run it again.') ('Administrator window mein masla aaya (code ' + $childCode + '). Agar woh jaldi band ho gaya, to ' + $LogDir + ' mein log dekhein, ya yeh file Desktop par copy karke (network drive par nahin) dobara chalayein.') 'Red'
        Wait-BeforeClose
    }
    exit $childCode
}

# ---- running as administrator from here on --------------------------------------------------------------------------

$results = New-Object System.Collections.ArrayList
function Add-Result {
    param([string]$Step, [bool]$Ok, [string]$Detail, [string]$Kind = '')
    [void]$results.Add([pscustomobject]@{ Step = $Step; Ok = $Ok; Detail = $Detail; Kind = $Kind })
}

function Install-BranchCa {
    $b64 = ($CaPem -replace '-----(BEGIN|END) CERTIFICATE-----', '') -replace '\s', ''
    $der = [Convert]::FromBase64String($b64)
    $cert = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 -ArgumentList (, $der)
    if ($cert.Thumbprint -ne $CaThumbprint) {
        throw ('the embedded certificate (' + $cert.Thumbprint + ') is not the expected one (' + $CaThumbprint + ')')
    }
    $sha = [Security.Cryptography.SHA256]::Create()
    $sha256 = -join ($sha.ComputeHash($cert.RawData) | ForEach-Object { $_.ToString('X2') })
    if ($sha256 -ne $CaSha256) { throw 'the embedded certificate SHA-256 fingerprint does not match' }

    $store = New-Object System.Security.Cryptography.X509Certificates.X509Store -ArgumentList ([System.Security.Cryptography.X509Certificates.StoreName]::Root), ([System.Security.Cryptography.X509Certificates.StoreLocation]::LocalMachine)
    $store.Open([System.Security.Cryptography.X509Certificates.OpenFlags]::ReadWrite)
    try {
        $already = @($store.Certificates | Where-Object { $_.Thumbprint -eq $CaThumbprint }).Count -gt 0
        if (-not $already) { $store.Add($cert) }
    } finally {
        $store.Close()
    }
    $present = @(Get-ChildItem -Path 'Cert:\LocalMachine\Root' | Where-Object { $_.Thumbprint -eq $CaThumbprint })
    if ($present.Count -eq 0) { throw 'the certificate is not in the Trusted Root store after adding it' }
    if ($already) { return 'already trusted (' + $CaThumbprint + ')' }
    return 'installed in Trusted Root (' + $CaThumbprint + ')'
}

function Set-HostsEntry {
    $path = Join-Path $env:SystemRoot 'System32\drivers\etc\hosts'
    $lines = @()
    if (Test-Path -LiteralPath $path) { $lines = @([IO.File]::ReadAllLines($path)) }
    $out = New-Object 'System.Collections.Generic.List[string]'
    $present = $false
    foreach ($line in $lines) {
        $body = ($line -split '#', 2)[0].Trim()
        if ($body -eq '') { $out.Add($line); continue }
        $tokens = @($body -split '\s+')
        $names = @($tokens | Select-Object -Skip 1)
        if (@($names | Where-Object { $_ -ieq $EdgeHost }).Count -eq 0) { $out.Add($line); continue }
        if ((-not $present) -and $tokens[0] -eq $EdgeIp -and $names.Count -eq 1) { $present = $true; $out.Add($line); continue }
        # an old or duplicate line for the branch server name: drop the name, keep any other names on that line
        $others = @($names | Where-Object { $_ -ine $EdgeHost })
        if ($others.Count -gt 0) { $out.Add($tokens[0] + "`t" + ($others -join ' ')) }
    }
    if (-not $present) { $out.Add($HostsLine) }

    $changed = (($out -join "`n") -ne ($lines -join "`n"))
    if ($changed) {
        $backup = $path + '.before-bingoo'
        if ((Test-Path -LiteralPath $path) -and -not (Test-Path -LiteralPath $backup)) { Copy-Item -LiteralPath $path -Destination $backup }
        $wasReadOnly = $false
        if (Test-Path -LiteralPath $path) {
            $item = Get-Item -LiteralPath $path
            if ($item.IsReadOnly) { $wasReadOnly = $true; $item.IsReadOnly = $false }
        }
        try {
            [IO.File]::WriteAllLines($path, [string[]]$out.ToArray(), (New-Object System.Text.UTF8Encoding -ArgumentList $false))
        } finally {
            if ($wasReadOnly) { (Get-Item -LiteralPath $path).IsReadOnly = $true }
        }
    }
    try { & ipconfig.exe /flushdns | Out-Null } catch { }
    if ($changed) { return 'written: ' + $HostsLine }
    return 'already present'
}

function Set-BingooShortcuts {
    $iconDir = Join-Path $env:ProgramData 'BingooPOS'
    New-Item -ItemType Directory -Force -Path $iconDir | Out-Null
    $iconPath = Join-Path $iconDir 'bingoo.ico'
    [IO.File]::WriteAllBytes($iconPath, [Convert]::FromBase64String($IconB64))

    $publicDesktop = [Environment]::GetFolderPath('CommonDesktopDirectory')
    if (-not $publicDesktop) { $publicDesktop = Join-Path $env:PUBLIC 'Desktop' }
    New-Item -ItemType Directory -Force -Path $publicDesktop | Out-Null

    # Desktops of every user (and their OneDrive desktops): copies left by an earlier setup are refreshed, never duplicated.
    $profilesRoot = Join-Path $env:SystemDrive 'Users'
    if ($env:PUBLIC) { $profilesRoot = Split-Path -Parent $env:PUBLIC }
    $userDesktops = @([Environment]::GetFolderPath('Desktop'))
    foreach ($userDir in @(Get-ChildItem -LiteralPath $profilesRoot -Directory -ErrorAction SilentlyContinue)) {
        if ($userDir.Name -eq 'Public') { continue }
        $userDesktops += (Join-Path $userDir.FullName 'Desktop')
        foreach ($oneDrive in @(Get-ChildItem -LiteralPath $userDir.FullName -Directory -Filter 'OneDrive*' -ErrorAction SilentlyContinue)) {
            $userDesktops += (Join-Path $oneDrive.FullName 'Desktop')
        }
    }
    $userDesktops = @($userDesktops | Where-Object { $_ -and ($_ -ne $publicDesktop) } | Select-Object -Unique)

    $links = [ordered]@{
        'BINGOO Online'        = $UrlOnline
        'BINGOO Offline'       = $UrlOffline
        'Branch Server Status' = $UrlStatus
    }
    $refreshed = 0
    foreach ($name in $links.Keys) {
        $content = @('[InternetShortcut]', ('URL=' + $links[$name]), ('IconFile=' + $iconPath), 'IconIndex=0')
        Set-Content -LiteralPath (Join-Path $publicDesktop ($name + '.url')) -Value $content -Encoding ASCII
        foreach ($desktop in $userDesktops) {
            $old = Join-Path $desktop ($name + '.url')
            if (Test-Path -LiteralPath $old) {
                try { Set-Content -LiteralPath $old -Value $content -Encoding ASCII; $refreshed++ } catch { }
            }
        }
    }
    # refresh the icon cache so the Bingoo icon shows at once
    try { & (Join-Path $env:SystemRoot 'System32\ie4uinit.exe') -show | Out-Null } catch { }

    $detail = '3 on ' + $publicDesktop + ' (icon ' + $iconPath + ')'
    if ($refreshed -gt 0) { $detail += ', ' + $refreshed + ' older per-user copies refreshed' }
    return $detail
}

function Test-EdgeUrl {
    param([string]$Url)
    try {
        $response = Invoke-WebRequest -Uri $Url -UseBasicParsing -TimeoutSec 15
        return @{ Ok = $true; Kind = 'ok'; Detail = ('OK, secure connection (HTTP ' + [int]$response.StatusCode + ')') }
    } catch {
        $ex = $_.Exception
        if ($ex.PSObject.Properties['Response'] -and $ex.Response) {
            # The server answered over a VALIDATED connection; an HTTP error code still proves the certificate chain.
            $status = 0
            try { $status = [int]$ex.Response.StatusCode } catch { }
            return @{ Ok = $true; Kind = 'ok'; Detail = ('OK, secure connection (server answered HTTP ' + $status + ')') }
        }
        $status = ''
        if ($ex.PSObject.Properties['Status']) { $status = [string]$ex.Status }
        $messages = ''
        $e = $ex
        while ($e) { $messages += ' ' + $e.Message; $e = $e.InnerException }
        $kind = 'network'
        if ($status -eq 'TrustFailure' -or $status -eq 'SecureChannelFailure' -or $messages -match 'trust relationship|certificate|SSL/TLS') {
            $kind = 'trust'
        } elseif ($status -eq 'NameResolutionFailure' -or $messages -match 'could not be resolved|No such host') {
            $kind = 'name'
        }
        return @{ Ok = $false; Kind = $kind; Detail = ('FAILED: ' + $ex.Message) }
    }
}

# ---- 1..4 -----------------------------------------------------------------------------------------------------------

$exitCode = 1
$transcript = $false
try {
    New-Item -ItemType Directory -Force -Path $LogDir | Out-Null
    Start-Transcript -Path (Join-Path $LogDir ('counter-setup-' + (Get-Date -Format 'yyyyMMdd-HHmmss') + '.log')) | Out-Null
    $transcript = $true
} catch { }

try {
    try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch { }

    Write-Host ''
    Write-Say ('[1/4] Trusting the branch certificate: ' + $CaName) ('[1/4] Branch certificate trust kiya ja raha hai: ' + $CaName) 'White'
    try { Add-Result 'Branch certificate' $true (Install-BranchCa) } catch { Add-Result 'Branch certificate' $false ('FAILED: ' + $_.Exception.Message) }

    Write-Say ('[2/4] Adding ' + $EdgeHost + ' to the hosts file') ('[2/4] Hosts file mein ' + $EdgeHost + ' likha ja raha hai') 'White'
    try { Add-Result 'Hosts line' $true (Set-HostsEntry) } catch { Add-Result 'Hosts line' $false ('FAILED: ' + $_.Exception.Message + ' (an antivirus may be protecting the hosts file)') }

    Write-Say '[3/4] Creating the three desktop shortcuts with the Bingoo icon' '[3/4] Desktop par Bingoo icon wale teen shortcuts banaye ja rahe hain' 'White'
    try { Add-Result 'Desktop shortcuts' $true (Set-BingooShortcuts) } catch { Add-Result 'Desktop shortcuts' $false ('FAILED: ' + $_.Exception.Message) }

    Write-Say '[4/4] Checking the secure connection to the Branch Server (by name and by IP)' '[4/4] Branch Server se secure connection check ho raha hai (naam aur IP dono se)' 'White'
    $byName = Test-EdgeUrl $CheckByName
    Add-Result ('Check ' + $CheckByName) $byName.Ok $byName.Detail $byName.Kind
    $byIp = Test-EdgeUrl $CheckByIp
    Add-Result ('Check ' + $CheckByIp) $byIp.Ok $byIp.Detail $byIp.Kind

    Write-Host ''
    Write-Host ('==== Result - ' + $BranchLabel + ' ====') -ForegroundColor Cyan
    foreach ($r in $results) {
        $mark = '[FAIL]'
        $color = 'Red'
        if ($r.Ok) { $mark = '[ OK ]'; $color = 'Green' }
        Write-Host ('{0} {1,-58} {2}' -f $mark, $r.Step, $r.Detail) -ForegroundColor $color
    }
    Write-Host ''

    $failed = @($results | Where-Object { -not $_.Ok })
    if ($failed.Count -eq 0) {
        $exitCode = 0
        Write-Say 'All good. Close Chrome completely and open it again, then use the desktop shortcuts.' 'Sab theek hai. Chrome ko poori tarah band karke dobara kholein, phir desktop shortcuts istemal karein.' 'Green'
        Write-Say 'BINGOO Online works wherever there is internet. BINGOO Offline works only on the shop network.' 'BINGOO Online har jagah internet par chalta hai. BINGOO Offline sirf dukaan ke network par chalta hai.' 'Green'
    } else {
        $kinds = @($failed | ForEach-Object { $_.Kind })
        if ($kinds -contains 'trust') {
            Write-Say 'The certificate check FAILED. Do not click past any browser warning. Ask Bingoo support: the Branch Server certificate may not match this setup file.' 'Certificate check FAIL hua. Browser ki kisi warning ko nazar-andaaz na karein. Bingoo support se rabta karein: ho sakta hai Branch Server ka certificate is setup file se match na kare.' 'Red'
        }
        if ($byName.Kind -eq 'name' -and $byIp.Ok) {
            Write-Say ('The name ' + $EdgeHost + ' was not found although the IP works: check the hosts line above and run this file again.') ('Naam ' + $EdgeHost + ' nahin mila halaan ke IP chal raha hai: upar hosts line dekhein aur yeh file dobara chalayein.') 'Red'
        }
        if ($kinds -contains 'network' -or ($kinds -contains 'name' -and -not $byIp.Ok)) {
            Write-Say ('The Branch Server did not answer. Check that this PC is on the shop network (' + $LanHint + ') and that the Branch Server PC is switched on.') ('Branch Server ne jawab nahin diya. Check karein ke yeh PC dukaan ke network (' + $LanHint + ') par hai aur Branch Server wala PC on hai.') 'Red'
        }
        Write-Say 'Fix the problem and run this file again (running it again is safe).' 'Masla theek karke yeh file dobara chalayein (dobara chalana bilkul theek hai).' 'Red'
    }
} catch {
    $exitCode = 1
    Write-Host ''
    Write-Say ('Setup stopped because of an unexpected error: ' + $_.Exception.Message) ('Ek ghalti ki wajah se setup ruk gaya: ' + $_.Exception.Message) 'Red'
} finally {
    if ($transcript) {
        Write-Host ('Log: ' + $LogDir) -ForegroundColor DarkGray
        try { Stop-Transcript | Out-Null } catch { }
    }
    Wait-BeforeClose
}
exit $exitCode
