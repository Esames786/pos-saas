          <TextBlock x:Name="TxtFinishBody" Style="{StaticResource P}"/>
          <Button x:Name="BtnOpenOffline" Style="{StaticResource Action}" Content="Open BINGOO Offline" Visibility="Collapsed"/>
        </StackPanel>

      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>
'@

# ==== system primitives: the ONLY functions that touch Windows (paths, certificate store, DNS cache, icon cache) =====

function Get-CounterPaths {
    $publicDesktop = [Environment]::GetFolderPath('CommonDesktopDirectory')
    if (-not $publicDesktop) { $publicDesktop = Join-Path $env:PUBLIC 'Desktop' }
    $base = Join-Path $env:ProgramData 'BingooPOS'
    return @{
        Hosts         = (Join-Path $env:SystemRoot 'System32\drivers\etc\hosts')
        PublicDesktop = $publicDesktop
        IconPath      = (Join-Path $base 'bingoo.ico')
        StateFile     = (Join-Path $base 'counter\state.json')
        LogDir        = (Join-Path $base 'logs')
    }
}

function Get-UserDesktops {
    $profilesRoot = Join-Path $env:SystemDrive 'Users'
    if ($env:PUBLIC) { $profilesRoot = Split-Path -Parent $env:PUBLIC }
    $desktops = @([Environment]::GetFolderPath('Desktop'))
    foreach ($userDir in @(Get-ChildItem -LiteralPath $profilesRoot -Directory -ErrorAction SilentlyContinue)) {
        if ($userDir.Name -eq 'Public') { continue }
        $desktops += (Join-Path $userDir.FullName 'Desktop')
        foreach ($oneDrive in @(Get-ChildItem -LiteralPath $userDir.FullName -Directory -Filter 'OneDrive*' -ErrorAction SilentlyContinue)) {
            $desktops += (Join-Path $oneDrive.FullName 'Desktop')
        }
    }
    $public = [Environment]::GetFolderPath('CommonDesktopDirectory')
    return @($desktops | Where-Object { $_ -and ($_ -ne $public) } | Select-Object -Unique)
}

function Test-CaInStore {
    param([string]$Thumbprint)
    return @(Get-ChildItem -Path 'Cert:\LocalMachine\Root' | Where-Object { $_.Thumbprint -eq $Thumbprint }).Count -gt 0
}

function Add-CaToStore {
    param($Certificate, [bool]$Confirmed)
    if (-not $Confirmed) { throw 'The branch certificate is only trusted after you confirm it.' }
    $store = New-Object System.Security.Cryptography.X509Certificates.X509Store -ArgumentList ([System.Security.Cryptography.X509Certificates.StoreName]::Root), ([System.Security.Cryptography.X509Certificates.StoreLocation]::LocalMachine)
    $store.Open([System.Security.Cryptography.X509Certificates.OpenFlags]::ReadWrite)
    try { $store.Add($Certificate) } finally { $store.Close() }
}

function Remove-CaFromStore {
    param([string]$Thumbprint, [bool]$Confirmed)
    if (-not $Confirmed) { throw 'The branch certificate is only removed after you confirm it.' }
    $store = New-Object System.Security.Cryptography.X509Certificates.X509Store -ArgumentList ([System.Security.Cryptography.X509Certificates.StoreName]::Root), ([System.Security.Cryptography.X509Certificates.StoreLocation]::LocalMachine)
    $store.Open([System.Security.Cryptography.X509Certificates.OpenFlags]::ReadWrite)
    try {
        foreach ($cert in @($store.Certificates | Where-Object { $_.Thumbprint -eq $Thumbprint })) { $store.Remove($cert) }
    } finally { $store.Close() }
}

function Clear-DnsCache {
    try { & ipconfig.exe /flushdns | Out-Null } catch { }
}

function Update-IconCache {
    try { & (Join-Path $env:SystemRoot 'System32\ie4uinit.exe') -show | Out-Null } catch { }
}

# ==== core (no direct system access; testable with the primitives above replaced) ===================================

function Write-CounterLog {
    param([string]$Message)
    try {
        if (-not $script:CounterLogFile) {
            $dir = (Get-CounterPaths).LogDir
            New-Item -ItemType Directory -Force -Path $dir | Out-Null
            $script:CounterLogFile = Join-Path $dir ('counter-wizard-' + (Get-Date -Format 'yyyyMMdd-HHmmss') + '.log')
        }
        Add-Content -LiteralPath $script:CounterLogFile -Value ((Get-Date -Format 's') + '  ' + $Message) -Encoding ASCII
    } catch { }
}

function Get-Sha256Hex {
    param([byte[]]$Bytes)
    $sha = [System.Security.Cryptography.SHA256]::Create()
    return -join ($sha.ComputeHash($Bytes) | ForEach-Object { $_.ToString('X2') })
}

function Get-EmbeddedCa {
    $b64 = ($CaPem -replace '-----(BEGIN|END) CERTIFICATE-----', '') -replace '\s', ''
    $cert = New-Object System.Security.Cryptography.X509Certificates.X509Certificate2 -ArgumentList (, [Convert]::FromBase64String($b64))
    if ($cert.Thumbprint -ne $CaThumbprint) { throw ('the embedded certificate (' + $cert.Thumbprint + ') is not the expected one (' + $CaThumbprint + ')') }
    if ((Get-Sha256Hex $cert.RawData) -ne $CaSha256) { throw 'the embedded certificate SHA-256 fingerprint does not match' }
    return $cert
}

# ---- Ed25519 signature verification (RFC 8032), pure PowerShell 5.1 + System.Numerics ----

function Initialize-Ed25519 {
    if ($script:EdP) { return }
    $script:EdP = [System.Numerics.BigInteger]::Pow(2, 255) - 19
    $script:EdL = [System.Numerics.BigInteger]::Pow(2, 252) + [System.Numerics.BigInteger]::Parse('27742317777372353535851937790883648493')
    $script:EdD = Get-EdMod ([System.Numerics.BigInteger]::Negate(121665) * [System.Numerics.BigInteger]::ModPow(121666, $script:EdP - 2, $script:EdP))
    $script:EdD2 = Get-EdMod ($script:EdD * 2)
    $script:EdI = [System.Numerics.BigInteger]::ModPow(2, ($script:EdP - 1) / 4, $script:EdP)
    $bx = [System.Numerics.BigInteger]::Parse('15112221349535400772501151409588531511454012693041857206046113283949847762202')
    $by = [System.Numerics.BigInteger]::Parse('46316835694926478169428394003475163141307993866256225615783033603165251855960')
    $script:EdB = @($bx, $by, [System.Numerics.BigInteger]::One, (Get-EdMod ($bx * $by)))
}

function Get-EdMod {
    param([System.Numerics.BigInteger]$Value)
    $r = $Value % $script:EdP
    if ($r.Sign -lt 0) { $r = $r + $script:EdP }
    return $r
}

function ConvertTo-EdInt {
    param([byte[]]$Bytes)
    $buffer = New-Object byte[] ($Bytes.Length + 1)
    [Array]::Copy($Bytes, $buffer, $Bytes.Length)
    return New-Object System.Numerics.BigInteger -ArgumentList (, $buffer)
}

function Add-EdPoint {
    param($P, $Q)
    $m = $script:EdP
    $a = (($P[1] - $P[0]) * ($Q[1] - $Q[0])) % $m
    $b = (($P[1] + $P[0]) * ($Q[1] + $Q[0])) % $m
    $c = (($P[3] * $script:EdD2) % $m * $Q[3]) % $m
    $d = ($P[2] * 2 * $Q[2]) % $m
    $e = $b - $a; $f = $d - $c; $g = $d + $c; $h = $b + $a
    return , @((($e * $f) % $m), (($g * $h) % $m), (($f * $g) % $m), (($e * $h) % $m))
}

function Get-EdScalarMult {
    param($Point, [System.Numerics.BigInteger]$Scalar)
    $q = @([System.Numerics.BigInteger]::Zero, [System.Numerics.BigInteger]::One, [System.Numerics.BigInteger]::One, [System.Numerics.BigInteger]::Zero)
    $bits = $Scalar.ToByteArray()
    for ($i = $bits.Length * 8 - 1; $i -ge 0; $i--) {
        $q = Add-EdPoint $q $q
        if ((($bits[$i -shr 3] -shr ($i -band 7)) -band 1) -eq 1) { $q = Add-EdPoint $q $Point }
    }
    return , $q
}

function ConvertFrom-EdPoint {
    param([byte[]]$Bytes)
    if ($Bytes.Length -ne 32) { return $null }
    $b = [byte[]]$Bytes.Clone()
    $sign = ($b[31] -shr 7) -band 1
    $b[31] = $b[31] -band 0x7F
    $m = $script:EdP
    $y = ConvertTo-EdInt $b
    if ($y -ge $m) { return $null }
    $y2 = ($y * $y) % $m
    $u = Get-EdMod ($y2 - 1)
    $v = Get-EdMod ($script:EdD * $y2 + 1)
    $v3 = ($v * $v % $m) * $v % $m
    $v7 = ($v3 * $v3 % $m) * $v % $m
    $x = ($u * $v3 % $m) * [System.Numerics.BigInteger]::ModPow(($u * $v7) % $m, ($m - 5) / 8, $m) % $m
    $vx2 = ($v * $x % $m) * $x % $m
    if ($vx2 -ne $u) {
        if ($vx2 -eq (Get-EdMod ([System.Numerics.BigInteger]::Negate($u)))) { $x = ($x * $script:EdI) % $m } else { return $null }
    }
    if ($x.IsZero -and $sign -eq 1) { return $null }
    if ([int]($x % 2) -ne $sign) { $x = $m - $x }
    return , @($x, $y, [System.Numerics.BigInteger]::One, (($x * $y) % $m))
}

function Test-Ed25519Signature {
    param([byte[]]$Message, [byte[]]$Signature, [byte[]]$PublicKey)
    Initialize-Ed25519
    if ($null -eq $Signature -or $null -eq $PublicKey -or $Signature.Length -ne 64 -or $PublicKey.Length -ne 32) { return $false }
    $A = ConvertFrom-EdPoint $PublicKey
    $rBytes = [byte[]]$Signature[0..31]
    $R = ConvertFrom-EdPoint $rBytes
    if ($null -eq $A -or $null -eq $R) { return $false }
    $S = ConvertTo-EdInt ([byte[]]$Signature[32..63])
    if ($S -ge $script:EdL) { return $false }
    if ($null -eq $Message) { $Message = New-Object byte[] 0 }
    $sha = [System.Security.Cryptography.SHA512]::Create()
    $h = (ConvertTo-EdInt $sha.ComputeHash([byte[]]($rBytes + $PublicKey + $Message))) % $script:EdL
    $left = Get-EdScalarMult $script:EdB $S
    $right = Add-EdPoint $R (Get-EdScalarMult $A $h)
    return (Get-EdMod ($left[0] * $right[2] - $right[0] * $left[2])).IsZero -and (Get-EdMod ($left[1] * $right[2] - $right[1] * $left[2])).IsZero
}

# ---- origin of this file ----

function Get-OriginCheck {
    if (-not $SignedProfileB64) {
        return @{ Status = 'unsigned'; Kind = 'warn'; Message = 'This setup file is not signed by the Bingoo Cloud. Compare the certificate SHA-256 with the Offline Edge page before you trust it. / Yeh file signed nahin hai: certificate SHA-256 Offline Edge page se zaroor milayein.' }
    }
    try {
        $bytes = [Convert]::FromBase64String($SignedProfileB64)
        $valid = Test-Ed25519Signature -Message $bytes -Signature ([Convert]::FromBase64String($SignedProfileSig)) -PublicKey ([Convert]::FromBase64String($SignedProfileKey))
        if (-not $valid) { throw 'signature' }
        if ((Get-Sha256Hex ([Convert]::FromBase64String($SignedProfileKey))) -ne $SignedProfileKeySha256) { throw 'key' }
        $signed = [Text.Encoding]::UTF8.GetString($bytes) | ConvertFrom-Json
        $port = $signed.lan_https_port
        if ($null -eq $port) { $port = $signed.https_port }
        $sha = $signed.lan_ca_sha256
        if ($null -eq $sha) { $sha = $signed.ca_sha256 }
        $sha = ([string]$sha -replace '[:\s]', '').ToUpperInvariant()
        if ([string]$signed.lan_hostname -ne $EdgeHost -or [string]$signed.lan_ip -ne $EdgeIp -or [int]$port -ne $EdgePort -or $sha -ne $CaSha256) { throw 'mismatch' }
        return @{ Status = 'signed'; Kind = 'ok'; Message = ('Setup file verified: made by your Bingoo Cloud (key ' + $SignedProfileKeyId + '). / File ki tasdeeq ho gayi: aap ke Bingoo Cloud ne banayi hai.') }
    } catch {
        return @{ Status = 'invalid'; Kind = 'error'; Message = 'This setup file was CHANGED after the Bingoo Cloud made it. Do not use it: download a new one from the Online POS. / Yeh file Cloud ke baad TABDEEL hui hai. Isay istemal na karein: Online POS se nayi file download karein.' }
    }
}

# ---- certificate ----

function Invoke-CaStep {
    param([bool]$Confirmed)
    $cert = Get-EmbeddedCa
    $added = $false
    if (Test-CaInStore $CaThumbprint) {
        $detail = 'already trusted on this PC - nothing changed'
    } else {
        if (-not $Confirmed) { return @{ Ok = $false; Added = $false; Detail = 'waiting for your confirmation' } }
        Add-CaToStore -Certificate $cert -Confirmed $Confirmed
        if (-not (Test-CaInStore $CaThumbprint)) { throw 'the certificate is not in the Trusted Root store after adding it' }
        $added = $true
        $detail = 'installed in Trusted Root'
    }
    Update-CounterState @{ ca_thumbprint = $CaThumbprint; ca_added_by_setup = $added }
    Write-CounterLog ('certificate ' + $CaThumbprint + ': ' + $detail)
    return @{ Ok = $true; Added = $added; Detail = $detail }
}

# ---- hosts file (only lines that name the Branch Server host are ever touched) ----

function Read-HostsLines {
    $path = (Get-CounterPaths).Hosts
    if (Test-Path -LiteralPath $path) { return , @([IO.File]::ReadAllLines($path)) }
    return , @()
}

function Write-HostsLines {
    param([string[]]$Lines)
    $path = (Get-CounterPaths).Hosts
    $backup = $path + '.before-bingoo'
    if ((Test-Path -LiteralPath $path) -and -not (Test-Path -LiteralPath $backup)) { Copy-Item -LiteralPath $path -Destination $backup }
    $wasReadOnly = $false
    if (Test-Path -LiteralPath $path) {
        $item = Get-Item -LiteralPath $path
        if ($item.IsReadOnly) { $wasReadOnly = $true; $item.IsReadOnly = $false }
    }
    try {
        [IO.File]::WriteAllLines($path, $Lines, (New-Object System.Text.UTF8Encoding -ArgumentList $false))
    } finally {
        if ($wasReadOnly) { (Get-Item -LiteralPath $path).IsReadOnly = $true }
    }
    Clear-DnsCache
}

function Set-HostsMapping {
    $lines = Read-HostsLines
    $out = New-Object 'System.Collections.Generic.List[string]'
    $present = $false
    foreach ($line in $lines) {
        $body = ($line -split '#', 2)[0].Trim()
        if ($body -eq '') { $out.Add($line); continue }
        $tokens = @($body -split '\s+')
        $names = @($tokens | Select-Object -Skip 1)
        if (@($names | Where-Object { $_ -ieq $EdgeHost }).Count -eq 0) { $out.Add($line); continue }
        if ((-not $present) -and $tokens[0] -eq $EdgeIp -and $names.Count -eq 1) { $present = $true; $out.Add($line); continue }
        $others = @($names | Where-Object { $_ -ine $EdgeHost })
        if ($others.Count -gt 0) { $out.Add($tokens[0] + "`t" + ($others -join ' ')) }
    }
    if (-not $present) { $out.Add($HostsLine) }
    if (($out -join "`n") -eq ($lines -join "`n")) { return 'already present' }
    Write-HostsLines -Lines $out.ToArray()
    return 'written: ' + $HostsLine
}

function Remove-HostsMapping {
    param([string]$HostName)
    $lines = Read-HostsLines
    $out = New-Object 'System.Collections.Generic.List[string]'
    foreach ($line in $lines) {
        $body = ($line -split '#', 2)[0].Trim()
        if ($body -eq '') { $out.Add($line); continue }
        $tokens = @($body -split '\s+')
        $names = @($tokens | Select-Object -Skip 1)
        if (@($names | Where-Object { $_ -ieq $HostName }).Count -eq 0) { $out.Add($line); continue }
        $others = @($names | Where-Object { $_ -ine $HostName })
        if ($others.Count -gt 0) { $out.Add($tokens[0] + "`t" + ($others -join ' ')) }
    }
    if (($out -join "`n") -eq ($lines -join "`n")) { return 'not present' }
    Write-HostsLines -Lines $out.ToArray()
    return 'removed'
}

# ---- shortcuts, files, state ----

function Invoke-ShortcutsStep {
    $paths = Get-CounterPaths
    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $paths.IconPath) | Out-Null
    [IO.File]::WriteAllBytes($paths.IconPath, [Convert]::FromBase64String($IconB64))
    New-Item -ItemType Directory -Force -Path $paths.PublicDesktop | Out-Null
    $links = [ordered]@{}
    $links[$ShortcutNames[0]] = $UrlOnline
    $links[$ShortcutNames[1]] = $UrlOffline
    $links[$ShortcutNames[2]] = $UrlStatus
    $userDesktops = @(Get-UserDesktops)
    $files = @()
    $refreshed = 0
    foreach ($name in $links.Keys) {
        $content = @('[InternetShortcut]', ('URL=' + $links[$name]), ('IconFile=' + $paths.IconPath), 'IconIndex=0')
        $file = Join-Path $paths.PublicDesktop ($name + '.url')
        Set-Content -LiteralPath $file -Value $content -Encoding ASCII
        $files += $file
        foreach ($desktop in $userDesktops) {
            $old = Join-Path $desktop ($name + '.url')
            if (Test-Path -LiteralPath $old) {
                try { Set-Content -LiteralPath $old -Value $content -Encoding ASCII; $refreshed++ } catch { }
            }
        }
    }
    Update-IconCache
    $detail = '3 on ' + $paths.PublicDesktop
    if ($refreshed -gt 0) { $detail += ', ' + $refreshed + ' older per-user copies refreshed' }
    return @{ Ok = $true; Files = $files; Detail = $detail }
}

function Get-CounterState {
    $file = (Get-CounterPaths).StateFile
    if (Test-Path -LiteralPath $file) {
        try { return (Get-Content -LiteralPath $file -Raw | ConvertFrom-Json) } catch { }
    }
    return $null
}

function Update-CounterState {
    param([hashtable]$Changes)
    $file = (Get-CounterPaths).StateFile
    $state = @{}
    $old = Get-CounterState
    if ($old) { foreach ($prop in $old.PSObject.Properties) { $state[$prop.Name] = $prop.Value } }
    foreach ($key in $Changes.Keys) {
        if ($key -like '*_added_by_setup') {
            $state[$key] = ([bool]$state[$key]) -or ([bool]$Changes[$key])
        } elseif ($key -eq 'shortcuts') {
            $state[$key] = @(@($state[$key]) + @($Changes[$key]) | Where-Object { $_ } | Select-Object -Unique)
        } else {
            $state[$key] = $Changes[$key]
        }
    }
    $now = (Get-Date).ToString('s')
    if (-not $state['installed_at']) { $state['installed_at'] = $now }
    $state['updated_at'] = $now
    $state['setup'] = $SetupKind
    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $file) | Out-Null
    Set-Content -LiteralPath $file -Value ($state | ConvertTo-Json -Depth 4) -Encoding ASCII
}

function Remove-CounterFile {
    param([string]$Path)
    if (-not $Path -or -not (Test-Path -LiteralPath $Path -PathType Leaf)) { return $false }
    $paths = Get-CounterPaths
    $full = [IO.Path]::GetFullPath($Path)
    $allowed = ($full -eq [IO.Path]::GetFullPath($paths.IconPath)) -or ($full -eq [IO.Path]::GetFullPath($paths.StateFile))
    if ((-not $allowed) -and ($full -eq [IO.Path]::GetFullPath($paths.Hosts + '.before-bingoo'))) {
        # the hosts backup goes only when it is identical to the current hosts file (nothing of the user's is lost)
        $allowed = ((([IO.File]::ReadAllText($full)).TrimEnd()) -eq (([IO.File]::ReadAllText($paths.Hosts)).TrimEnd()))
    }
    if ((-not $allowed) -and $full.EndsWith('.url', [StringComparison]::OrdinalIgnoreCase)) {
        $folder = [IO.Path]::GetDirectoryName($full)
        foreach ($desktop in (@($paths.PublicDesktop) + @(Get-UserDesktops))) {
            if ($desktop -and ($folder -eq [IO.Path]::GetFullPath($desktop).TrimEnd('\'))) { $allowed = $true }
        }
        if ($allowed) { $allowed = ([IO.File]::ReadAllText($full) -match '^\[InternetShortcut\]') }
    }
    if (-not $allowed) { throw ('refusing to delete ' + $full) }
    [IO.File]::Delete($full)
    return $true
}

function Invoke-NetworkStep {
    $lines = @()
    $ok = $true
    $state = Get-CounterState
    if ($state -and $state.edge_host -and ([string]$state.edge_host -ne $EdgeHost)) {
        try { $lines += ('Old Branch Server name ' + $state.edge_host + ': ' + (Remove-HostsMapping ([string]$state.edge_host))) }
        catch { $ok = $false; $lines += ('Old Branch Server name: FAILED - ' + $_.Exception.Message) }
    }
    $hostsAdded = $false
    try {
        $h = Set-HostsMapping
        $hostsAdded = $h.StartsWith('written')
        $lines += ('Hosts file: ' + $h)
    } catch { $ok = $false; $lines += ('Hosts file: FAILED - ' + $_.Exception.Message + ' (an antivirus may be protecting the hosts file)') }
    $files = @()
    try {
        $s = Invoke-ShortcutsStep
        $files = @($s.Files)
        $lines += ('Shortcuts: ' + $s.Detail)
    } catch { $ok = $false; $lines += ('Shortcuts: FAILED - ' + $_.Exception.Message) }
    if ($ok) {
        Update-CounterState @{
            edge_host = $EdgeHost; edge_ip = $EdgeIp; edge_port = $EdgePort; hosts_line = $HostsLine
            hosts_added_by_setup = $hostsAdded; shortcuts = $files; icon = (Get-CounterPaths).IconPath
            branch = $BranchLabel; tenant = $TenantLabel
        }
    }
    Write-CounterLog ('network step: ' + ($lines -join ' | '))
    return @{ Ok = $ok; Lines = $lines }
}

function Invoke-UninstallCore {
    param([bool]$RemoveCa)
    $paths = Get-CounterPaths
    $state = Get-CounterState
    $lines = @()
    $ok = $true

    $files = @()
    if ($state -and $state.shortcuts) { $files = @($state.shortcuts) }
    else { foreach ($name in $ShortcutNames) { $files += (Join-Path $paths.PublicDesktop ($name + '.url')) } }
    $removed = 0
    foreach ($file in $files) {
        try { if (Remove-CounterFile ([string]$file)) { $removed++ } }
        catch { $ok = $false; $lines += ('Shortcut ' + $file + ': FAILED - ' + $_.Exception.Message) }
    }
    $lines += ('Shortcuts removed: ' + $removed)

    $hostNames = @($EdgeHost)
    if ($state -and $state.edge_host -and ([string]$state.edge_host -ne $EdgeHost)) { $hostNames += [string]$state.edge_host }
    foreach ($name in $hostNames) {
        try { $lines += ('Hosts line for ' + $name + ': ' + (Remove-HostsMapping $name)) }
        catch { $ok = $false; $lines += ('Hosts line for ' + $name + ': FAILED - ' + $_.Exception.Message) }
    }
    try { [void](Remove-CounterFile ($paths.Hosts + '.before-bingoo')) } catch { $lines += 'Hosts backup kept (the hosts file changed since the setup).' }

    $thumbprint = $CaThumbprint
    if ($state -and $state.ca_thumbprint) { $thumbprint = [string]$state.ca_thumbprint }
    $preExisting = [bool]($state -and $state.PSObject.Properties['ca_added_by_setup'] -and -not [bool]$state.ca_added_by_setup)
    if (-not $RemoveCa) {
        $lines += 'Branch certificate: kept (you did not ask to remove it)'
    } elseif ($preExisting) {
        $lines += 'Branch certificate: kept - it was already trusted before this setup'
    } elseif (Test-CaInStore $thumbprint) {
        try { Remove-CaFromStore -Thumbprint $thumbprint -Confirmed $RemoveCa; $lines += 'Branch certificate: removed' }
        catch { $ok = $false; $lines += ('Branch certificate: FAILED - ' + $_.Exception.Message) }
    } else {
        $lines += 'Branch certificate: not present'
    }

    foreach ($file in @($paths.IconPath, $paths.StateFile)) {
        try { [void](Remove-CounterFile $file) } catch { $ok = $false; $lines += ('File ' + $file + ': FAILED - ' + $_.Exception.Message) }
    }
    $stateDir = Split-Path -Parent $paths.StateFile
    if ((Test-Path -LiteralPath $stateDir) -and @(Get-ChildItem -LiteralPath $stateDir -Force).Count -eq 0) { [IO.Directory]::Delete($stateDir) }
    Write-CounterLog ('uninstall: ' + ($lines -join ' | '))
    return @{ Ok = $ok; Lines = $lines }
}

# ---- Branch Server over HTTPS (full validation; the ONLY network code; never anything but the Branch Server) ----

function Invoke-EdgeHttp {
    param([string]$Url, [string]$Method = 'GET', [string]$JsonBody = '', [int]$TimeoutMs = 10000)
    if (-not ($Url.StartsWith($EdgeBaseByName + '/', [StringComparison]::OrdinalIgnoreCase) -or $Url.StartsWith($EdgeBaseByIp + '/', [StringComparison]::Ordinal))) {
        throw ('refusing to contact ' + $Url + ': this setup only talks to the Branch Server')
    }
    try { [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12 } catch { }
    $request = [System.Net.HttpWebRequest]::Create($Url)
    $request.Method = $Method
    $request.Timeout = $TimeoutMs
    $request.ReadWriteTimeout = $TimeoutMs
    $request.AllowAutoRedirect = $false
    $request.Proxy = $null
    $request.Accept = 'application/json, text/html;q=0.9'
    $response = $null
    try {
        if ($JsonBody) {
            $bytes = [Text.Encoding]::UTF8.GetBytes($JsonBody)
            $request.ContentType = 'application/json'
            $request.ContentLength = $bytes.Length
            $stream = $request.GetRequestStream()
            try { $stream.Write($bytes, 0, $bytes.Length) } finally { $stream.Close(); [Array]::Clear($bytes, 0, $bytes.Length) }
        }
        $response = $request.GetResponse()
    } catch {
        $ex = $_.Exception
        while ($ex -and -not ($ex -is [System.Net.WebException]) -and $ex.InnerException) { $ex = $ex.InnerException }
        if ($ex -is [System.Net.WebException] -and $ex.Response) {
            $response = $ex.Response
        } else {
            $status = ''
            if ($ex -is [System.Net.WebException]) { $status = [string]$ex.Status }
            $messages = ''
            $e = $_.Exception
            while ($e) { $messages += ' ' + $e.Message; $e = $e.InnerException }
            $kind = 'network'
            if ($status -eq 'TrustFailure' -or $status -eq 'SecureChannelFailure' -or $messages -match 'trust relationship|certificate|SSL/TLS') { $kind = 'trust' }
            elseif ($status -eq 'NameResolutionFailure' -or $messages -match 'could not be resolved|No such host') { $kind = 'name' }
            return @{ Ok = $false; Kind = $kind; Status = 0; Body = ''; Message = $ex.Message }
        }
    }
    try {
        $reader = New-Object System.IO.StreamReader -ArgumentList $response.GetResponseStream()
        $text = $reader.ReadToEnd()
        $reader.Close()
        return @{ Ok = $true; Kind = 'ok'; Status = [int]$response.StatusCode; Body = $text; Message = '' }
    } finally { $response.Close() }
}

function Format-CheckLine {
    param([string]$Label, [string]$Url, $Result, [int]$Expect = 0)
    if ($Result.Ok -and ($Expect -eq 0 -or $Result.Status -eq $Expect)) { return ('[ OK ] ' + $Label + ' - secure, HTTP ' + $Result.Status) }
    if ($Result.Ok) { return ('[FAIL] ' + $Label + ' - secure, but HTTP ' + $Result.Status + ' (' + $Url + ')') }
    return ('[FAIL] ' + $Label + ' - ' + $Result.Message)
}

function Invoke-EdgeChecks {
    $byName = Invoke-EdgeHttp -Url ($EdgeBaseByName + '/edge/local/health')
    $byIp = Invoke-EdgeHttp -Url ($EdgeBaseByIp + '/edge/local/health')
    $login = Invoke-EdgeHttp -Url ($EdgeBaseByName + '/edge/local/login')
    $health = $null
    foreach ($r in @($byName, $byIp)) {
        if (-not $health -and $r.Ok -and $r.Status -eq 200) { try { $health = $r.Body | ConvertFrom-Json } catch { } }
    }
    $lines = @(
        (Format-CheckLine 'By name' ($EdgeBaseByName + '/edge/local/health') $byName),
        (Format-CheckLine 'By IP' ($EdgeBaseByIp + '/edge/local/health') $byIp),
        (Format-CheckLine 'Offline login page' ($EdgeBaseByName + '/edge/local/login') $login 200)
    )
    $hints = @()
    $keyOk = $true
    if ($health -and $health.PSObject.Properties['enrollment_key_sha256'] -and $SignedProfileKeySha256) {
        if (([string]$health.enrollment_key_sha256).ToUpperInvariant() -eq $SignedProfileKeySha256) {
            $lines += '[ OK ] Cloud key - the Branch Server was paired with the same Bingoo Cloud that made this file'
        } else {
            $keyOk = $false
            $lines += '[FAIL] Cloud key - this Branch Server belongs to a DIFFERENT Bingoo Cloud than this file'
        }
    }
    $kinds = @(@($byName, $byIp, $login) | Where-Object { -not $_.Ok } | ForEach-Object { $_.Kind })
    if ($kinds -contains 'trust' -or -not $keyOk) {
        $hints += 'The certificate check FAILED. Do not click past any browser warning. Ask Bingoo support. / Certificate check FAIL: browser warning ko nazar-andaaz na karein, Bingoo support se rabta karein.'
    }
    if ($byName.Kind -eq 'name' -and $byIp.Ok) {
        $hints += ('The name ' + $EdgeHost + ' was not found although the IP works: go Back and add the hosts line again. / Naam nahin mila, IP chal raha hai: Back ja kar hosts line dobara lagayein.')
    }
    if ($kinds -contains 'network' -or ($kinds -contains 'name' -and -not $byIp.Ok)) {
        $hints += ('The Branch Server did not answer. Check that this PC is on the shop network (' + $LanHint + ') and the Branch Server PC is on. If its address changed, download a NEW setup file from the Online POS and choose Repair. / Branch Server ne jawab nahin diya: network aur Branch Server PC check karein; address badla ho to Online POS se nayi file le kar Repair karein.')
    }
    $loginOk = $login.Ok -and $login.Status -eq 200
    if ($byName.Ok -and -not $loginOk) {
        $hints += 'The Branch Server answered but its login page did not. It may still be starting: wait one minute and click Check again. / Login page abhi nahin khula: ek minute ruk kar dobara check karein.'
    }
    $result = @{ Ok = ($byName.Ok -and $byIp.Ok -and $loginOk -and $keyOk); Lines = $lines; Hints = $hints; Health = $health }
    Write-CounterLog ('checks: ' + ($lines -join ' | '))
    return $result
}

# ---- optional: the user's own Edge PIN ----

function Test-PinPolicy {
    param([string]$Pin, [string]$Repeat)
    if (-not $Pin) { return 'Type your new PIN in both boxes. / Dono khanon mein naya PIN likhein.' }
    if ($Pin -cne $Repeat) { return 'The two PINs are different. / Dono PIN alag hain.' }
    if ($Pin -notmatch '^[0-9]{6,12}$') { return 'The PIN must be 6 to 12 digits (numbers only). / PIN 6 se 12 hindson ka ho (sirf numbers).' }
    if ($Pin -match '^([0-9])\1+$') { return 'The PIN must not be one digit repeated. / PIN mein ek hi hindsa baar baar na ho.' }
    if (@('123456', '654321', '123123', '000000') -contains $Pin) { return 'This PIN is too easy to guess. / Yeh PIN bohat aasaan hai.' }
    return ''
}

function Invoke-PinEnrollment {
    param([string]$Pin)
    if (-not $EnrollAssertionB64) { return @{ Ok = $false; Message = 'This setup file has no PIN setup code. Ask your manager to set your Edge PIN.' } }
    if ($Pin -notmatch '^[0-9]{6,12}$') { return @{ Ok = $false; Message = 'The PIN must be 6 to 12 digits.' } }
    $assertionJson = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String($EnrollAssertionB64))
    $body = '{"assertion":' + $assertionJson + ',"credential":"' + $Pin + '","type":"pin"}'
    $response = Invoke-EdgeHttp -Url ($EdgeBaseByName + '/edge/local/enroll') -Method 'POST' -JsonBody $body
    $body = $null
    $Pin = $null
    $reason = ''
    $accepted = $false
    if ($response.Ok -and $response.Body) {
        try {
            $json = $response.Body | ConvertFrom-Json
            if ($json.PSObject.Properties['reason']) { $reason = [string]$json.reason }
            if ($json.PSObject.Properties['ok']) { $accepted = [bool]$json.ok }
        } catch { }
    }
    $reason = $reason -replace '[^\x20-\x7E]', ''
    if ($reason.Length -gt 160) { $reason = $reason.Substring(0, 160) }
    Write-CounterLog ('edge PIN setup: HTTP ' + $response.Status + ' ' + $reason)
    if (-not $response.Ok) {
        return @{ Ok = $false; Message = ('Could not reach the Branch Server securely: ' + $response.Message + ' / Branch Server tak mehfooz rabta nahin hua.') }
    }
    if (($response.Status -eq 201 -or $response.Status -eq 200) -and $accepted) {
        return @{ Ok = $true; Message = 'Your Edge PIN is set. Log in to BINGOO Offline with your employee code and this PIN. / Aap ka Edge PIN set ho gaya: BINGOO Offline mein employee code aur yeh PIN istemal karein.' }
    }
    if ($response.Status -eq 404) {
        return @{ Ok = $false; Message = 'This Branch Server cannot set PINs from a counter yet (it needs an update). Ask your manager to set your Edge PIN. / Is Branch Server par counter se PIN set nahin hota: manager se PIN set karwayein.' }
    }
    if ($response.Status -eq 429) {
        return @{ Ok = $false; Message = 'Too many tries. Wait one minute and try again. / Bohat koshishein: ek minute ruk kar dobara karein.' }
    }
    if ($reason -match 'expire') {
        return @{ Ok = $false; Message = 'The PIN setup code in this file has expired (it works for about 15 minutes). Download the setup again from the Online POS. / Code ki muddat khatam: Online POS se dobara download karein.' }
    }
    if ($reason -match 'replay|used|consumed') {
        return @{ Ok = $false; Message = 'The PIN setup code in this file was already used. Download the setup again from the Online POS. / Yeh code pehle istemal ho chuka: dobara download karein.' }
    }
    return @{ Ok = $false; Message = ('The Branch Server did not accept the PIN (HTTP ' + $response.Status + '): ' + $reason) }
}

# ---- the counter (terminal) hint ----

function Get-TerminalStatus {
    param($Health)
    if ($TerminalId -le 0) { return @{ Kind = 'info'; Known = $false; Message = 'No default counter is linked to your user. Pick your counter when you log in.' } }
    if ($null -eq $Health -or -not $Health.PSObject.Properties['terminals']) {
        return @{ Kind = 'info'; Known = $false; Message = 'The Branch Server does not publish counter status. Your manager can check it on the Branch Server Status page. / Counter ka status Branch Server Status page par dekha ja sakta hai.' }
    }
    $match = @($Health.terminals | Where-Object { [int]$_.id -eq $TerminalId })
    if ($match.Count -eq 0) {
        return @{ Kind = 'warn'; Known = $false; Message = 'The Branch Server does not know this counter yet. It updates from the Cloud about once a minute; click Check again shortly. / Branch Server abhi is counter ko nahin jaanta: thori dair baad dobara check karein.' }
    }
    if ($match[0].PSObject.Properties['active'] -and -not [bool]$match[0].active) {
        return @{ Kind = 'warn'; Known = $true; Message = 'This counter is switched off on the Branch Server. Ask your manager. / Yeh counter Branch Server par band hai: manager se poochein.' }
    }
    return @{ Kind = 'ok'; Known = $true; Message = 'The Branch Server knows this counter. / Branch Server is counter ko jaanta hai.' }
}

function Get-FinishSummary {
    param([hashtable]$State)
    if ($State.Mode -eq 'uninstall') {
        if ($State.Removed -and $State.RemoveResults.Ok) {
            return @{ Ready = $false; ExitCode = 0; Kind = 'ok'; Title = 'Bingoo Offline was removed from this PC'; Body = (($State.RemoveResults.Lines -join "`n") + "`n`nBingoo Offline is PC se hata diya gaya.") }
        }
        return @{ Ready = $false; ExitCode = 1; Kind = 'error'; Title = 'Removal needs attention'; Body = 'Some parts were not removed. Run this file again and choose Remove, or ask Bingoo support. / Kuch hisse nahin hate: dobara Remove chalayein.' }
    }
    $problems = @()
    if (-not $State.CaOk) { $problems += '- The branch certificate is not trusted yet: go Back to the certificate page and confirm it.' }
    if (-not $State.NetworkOk) { $problems += '- The hosts line or the shortcuts were not added: go Back and click "Add the hosts line and shortcuts".' }
    if (-not ($State.Checks -and $State.Checks.Ok)) {
        $problems += '- The Branch Server check did not pass.'
        if ($State.Checks) { foreach ($hint in @($State.Checks.Hints)) { $problems += ('  ' + $hint) } }
    }
    $notes = @()
    if ($State.PinStatus -eq 'failed') { $notes += '- Your Edge PIN was not set. Ask your manager to set it, or download the setup again and retry.' }
    if ($State.PinStatus -eq 'set') { $notes += '- Your Edge PIN is set.' }
    if ($problems.Count -eq 0) {
        $body = 'Use BINGOO Offline when the internet is down and BINGOO Online when it works. Log in with your employee code and your Edge PIN.' + "`n" + 'Internet band ho to BINGOO Offline, chal raha ho to BINGOO Online. Login: employee code + Edge PIN.'
        if ($notes.Count -gt 0) { $body += "`n`n" + ($notes -join "`n") }
        return @{ Ready = $true; ExitCode = 0; Kind = 'ok'; Title = 'Offline Counter Ready'; Body = $body }
    }
    return @{ Ready = $false; ExitCode = 1; Kind = 'error'; Title = 'Setup needs attention'; Body = (($problems + $notes) -join "`n") + "`n`n" + 'Masla theek karke dobara chalayein (Repair).' }
}

# ---- console helpers ----

function Write-Say {
    param([string]$English, [string]$Urdu, [string]$Color = 'Gray')
    Write-Host $English -ForegroundColor $Color
    if ($Urdu) { Write-Host ('   ' + $Urdu) -ForegroundColor $Color }
}

function Wait-BeforeClose {
    Write-Host ''
    Write-Say 'Press Enter to close this window.' 'Window band karne ke liye Enter dabayein.' 'White'
    try { [void](Read-Host) } catch { }
}

function Test-IsAdministrator {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    return ([Security.Principal.WindowsPrincipal]$identity).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)
}

# ---- window helpers ----

function Set-Status {
    param($Target, [string]$Text, [string]$Kind = 'info')
    $colors = @{ ok = '#FF15803D'; warn = '#FFB45309'; error = '#FFB91C1C'; info = '#FF1F2937' }
    if (-not $colors.ContainsKey($Kind)) { $Kind = 'info' }
    $Target.Text = $Text
    $Target.Foreground = (New-Object System.Windows.Media.BrushConverter).ConvertFromString($colors[$Kind])
}

function Update-UiNow {
    $Window.Dispatcher.Invoke([Action] { }, [System.Windows.Threading.DispatcherPriority]::Background)
}

function Show-Message {
    param([string]$Text, [string]$Title, [string]$Buttons = 'OK', [string]$Icon = 'Information')
    return [System.Windows.MessageBox]::Show($Window, $Text, $Title, $Buttons, $Icon)
}

function Invoke-UiAction {
    param([scriptblock]$Action)
    $Window.Cursor = [System.Windows.Input.Cursors]::Wait
    try { & $Action }
    catch {
        Write-CounterLog ('error: ' + $_.Exception.Message)
        [void](Show-Message ('Something went wrong: ' + $_.Exception.Message + "`n`nKuch ghalat ho gaya. Dobara koshish karein ya Bingoo support se rabta karein.") 'Bingoo Offline Counter' 'OK' 'Error')
    } finally { $Window.Cursor = $null }
}

function Get-PageFlow {
    if ($State.Mode -eq 'uninstall') { return , @('PageWelcome', 'PageRemove', 'PageFinish') }
    $flow = @('PageWelcome', 'PageCa', 'PageNetwork', 'PageCheck')
    if ($EnrollAssertionB64) { $flow += 'PagePin' }
    if ($TerminalId -gt 0) { $flow += 'PageTerminal' }
    $flow += 'PageFinish'
    return , $flow
}

function Update-NextButton {
    $enabled = $true
    switch ($State.Page) {
        'PageWelcome' { $enabled = ($State.Mode -eq 'uninstall') -or ($State.Origin.Status -ne 'invalid') }
        'PageCa' { $enabled = $State.CaOk }
        'PageNetwork' { $enabled = $State.NetworkOk }
        'PageRemove' { $enabled = $State.Removed }
    }
    $ui.BtnNext.IsEnabled = [bool]$enabled
}

function Enter-CaPage {
    $r = Invoke-CaStep -Confirmed $false
    if ($r.Ok) {
        $State.CaOk = $true
        Set-Status $ui.TxtCaStatus 'This certificate is already trusted on this PC - nothing to do. / Yeh certificate pehle se trusted hai.' 'ok'
        $ui.ChkTrustCa.IsChecked = $true
        $ui.ChkTrustCa.IsEnabled = $false
        $ui.BtnTrustCa.IsEnabled = $false
    } else {
        Set-Status $ui.TxtCaStatus 'Not trusted on this PC yet. Compare the SHA-256, tick the box and click Trust this certificate. / Abhi trusted nahin: SHA-256 milayein, box tick karein aur button dabayein.' 'warn'
        $ui.ChkTrustCa.IsEnabled = $true
        $ui.BtnTrustCa.IsEnabled = ($ui.ChkTrustCa.IsChecked -eq $true)
    }
}

function Invoke-CheckRun {
    Set-Status $ui.TxtCheckResult 'Checking the Branch Server ... / Check ho raha hai ...' 'info'
    $ui.TxtCheckHint.Text = ''
    Update-UiNow
    $checks = Invoke-EdgeChecks
    $State.Checks = $checks
    if ($checks.Health) { $State.Health = $checks.Health }
    $kind = 'error'
    if ($checks.Ok) { $kind = 'ok' }
    Set-Status $ui.TxtCheckResult ($checks.Lines -join "`n") $kind
    Set-Status $ui.TxtCheckHint ($checks.Hints -join "`n`n") 'error'
}

function Invoke-TerminalRun {
    if (-not $State.Health) {
        $h = Invoke-EdgeHttp -Url ($EdgeBaseByName + '/edge/local/health')
        if ($h.Ok -and $h.Status -eq 200) { try { $State.Health = $h.Body | ConvertFrom-Json } catch { } }
    }
    $t = Get-TerminalStatus -Health $State.Health
    $State.TerminalStatus = $t
    Set-Status $ui.TxtTerminalStatus $t.Message $t.Kind
}

function Enter-RemovePage {
    $paths = Get-CounterPaths
    $st = Get-CounterState
    $list = @('- the three desktop shortcuts (BINGOO Online, BINGOO Offline, Branch Server Status)', ('- the hosts line for ' + $EdgeHost), ('- the Bingoo icon and the setup record in ' + (Split-Path -Parent $paths.IconPath)))
    if ($st -and $st.edge_host -and ([string]$st.edge_host -ne $EdgeHost)) { $list += ('- the old hosts line for ' + $st.edge_host) }
    $ui.TxtRemoveList.Text = ($list -join "`n")
    $ui.ChkRemoveCa.IsChecked = $false
    if ($st -and $st.PSObject.Properties['ca_added_by_setup'] -and -not [bool]$st.ca_added_by_setup) {
        $ui.ChkRemoveCa.IsEnabled = $false
        $ui.TxtRemoveCaNote.Text = 'The branch certificate was already trusted before this setup, so it is kept. / Certificate setup se pehle ka hai, is liye rakha jayega.'
    } else {
        $ui.ChkRemoveCa.IsEnabled = $true
        $ui.TxtRemoveCaNote.Text = 'Remove it only if this PC will never use BINGOO Offline again. / Sirf tab hatayein jab yeh PC BINGOO Offline kabhi istemal na kare.'
    }
}

function Enter-FinishPage {
    $summary = Get-FinishSummary -State $State
    $State.ExitCode = $summary.ExitCode
    Set-Status $ui.TxtFinishTitle $summary.Title $summary.Kind
    $ui.TxtFinishBody.Text = $summary.Body
    if ($summary.Ready) { $ui.BtnOpenOffline.Visibility = 'Visible' } else { $ui.BtnOpenOffline.Visibility = 'Collapsed' }
    Write-CounterLog ('finish: ' + $summary.Title)
}

function Show-Page {
    param([string]$Name)
    foreach ($page in @('PageWelcome', 'PageCa', 'PageNetwork', 'PageCheck', 'PagePin', 'PageTerminal', 'PageRemove', 'PageFinish')) {
        $ui[$page].Visibility = 'Collapsed'
    }
    $ui[$Name].Visibility = 'Visible'
    $State.Page = $Name
    $flow = Get-PageFlow
    $index = [Array]::IndexOf($flow, $Name)
    $ui.StepLabel.Text = 'Step ' + ($index + 1) + ' of ' + $flow.Count
    $ui.BtnBack.IsEnabled = ($index -gt 0 -and $Name -ne 'PageFinish')
    if ($Name -eq 'PageFinish') { $ui.BtnNext.Visibility = 'Collapsed' } else { $ui.BtnNext.Visibility = 'Visible' }
    switch ($Name) {
        'PageCa' { Enter-CaPage }
        'PageCheck' { Invoke-CheckRun }
        'PageTerminal' { Invoke-TerminalRun }
        'PageRemove' { Enter-RemovePage }
        'PageFinish' { Enter-FinishPage }
    }
    Update-NextButton
}

function Initialize-CounterWindow {
    param($XamlDoc)
    $script:ui = @{}
    foreach ($node in $XamlDoc.SelectNodes('//*')) {
        $controlName = $node.GetAttribute('x:Name')
        if ($controlName) { $ui[$controlName] = $Window.FindName($controlName) }
    }
    $script:State = @{
        Mode = 'install'; Page = 'PageWelcome'; Origin = $null; CaOk = $false; NetworkOk = $false; Checks = $null; Health = $null
        PinStatus = 'not-offered'; TerminalStatus = $null; Removed = $false; RemoveResults = $null; ExitCode = 1
    }

    $Window.Title = 'Bingoo Offline Counter - ' + $BranchLabel
    try {
        $ico = [Convert]::FromBase64String($IconB64)
        $png = New-Object byte[] ($ico.Length - 22)
        [Array]::Copy($ico, 22, $png, 0, $png.Length)
        $bitmap = New-Object System.Windows.Media.Imaging.BitmapImage
        $bitmap.BeginInit()
        $bitmap.StreamSource = New-Object System.IO.MemoryStream -ArgumentList (, $png)
        $bitmap.CacheOption = [System.Windows.Media.Imaging.BitmapCacheOption]::OnLoad
        $bitmap.EndInit()
        $ui.Logo.Source = $bitmap
        $Window.Icon = $bitmap
    } catch { }

    $ui.HeaderSub.Text = $BranchLabel + '  -  Branch Server ' + $EdgeHost + ' (' + $EdgeIp + ')'
    if ($TenantLabel) { $ui.TxtTenant.Text = $TenantLabel } else { $ui.TxtTenant.Text = '-' }
    $ui.TxtBranch.Text = $BranchLabel
    $ui.TxtServer.Text = $EdgeHost
    $ui.TxtServerIp.Text = $EdgeIp + '  (port ' + $EdgePort + ')'
    $ui.TxtWelcomeSha.Text = $CaSha256Display
    $State.Origin = Get-OriginCheck
    Set-Status $ui.TxtOrigin $State.Origin.Message $State.Origin.Kind
    $existing = Get-CounterState
    if ($existing) {
        $note = 'This PC was set up on ' + $existing.installed_at + ' for ' + $existing.edge_host + ' (' + $existing.edge_ip + ').'
        if (([string]$existing.edge_host -ne $EdgeHost) -or ([string]$existing.edge_ip -ne $EdgeIp)) {
            $note += ' This file is for ' + $EdgeHost + ' (' + $EdgeIp + '): Repair switches the PC to the new address. / Repair PC ko naye address par le jayega.'
        }
        Set-Status $ui.TxtSetupState $note 'info'
        $ui.RbRepair.IsChecked = $true
        $State.Mode = 'repair'
    } else {
        Set-Status $ui.TxtSetupState 'This PC is not set up yet. / Yeh PC abhi set up nahin hai.' 'info'
        $ui.RbInstall.IsChecked = $true
    }
    if ($State.Origin.Status -eq 'invalid') {
        $ui.RbInstall.IsEnabled = $false
        $ui.RbRepair.IsEnabled = $false
        $ui.RbUninstall.IsChecked = $true
        $State.Mode = 'uninstall'
    }

    $ui.TxtCaName.Text = $CaName
    $ui.TxtCaSha.Text = $CaSha256Display
    $ui.TxtCaValid.Text = $CaValidUntil
    $ui.TxtHostsLine.Text = $HostsLine
    $ui.TxtShortcutOnline.Text = 'BINGOO Online  -  the Online POS over the internet (' + $UrlOnline + ')'
    $ui.TxtShortcutOffline.Text = 'BINGOO Offline  -  the Branch Server on the shop network, when the internet is down (' + $UrlOffline + ')'
    $ui.TxtShortcutStatus.Text = 'Branch Server Status  -  for the manager (' + $UrlStatus + ')'
    if ($EnrollAssertionB64) {
        $State.PinStatus = 'offered'
        $ui.TxtPinWho.Text = 'PIN for: ' + $EnrollUserLabel
        try {
            $until = [DateTimeOffset]::FromUnixTimeSeconds([long]$EnrollExpiresAt).ToLocalTime().ToString('HH:mm')
            $ui.TxtPinExpiry.Text = 'This PIN setup code works once, until about ' + $until + ' (15 minutes after the download). / Yeh code sirf ek dafa, takreeban ' + $until + ' tak chalta hai.'
        } catch { }
    }
    if ($TerminalId -gt 0) { $ui.TxtTerminalHint.Text = $TerminalLabel + '  (terminal #' + $TerminalId + ')' }

    $ui.RbInstall.Add_Checked({ $State.Mode = 'install'; Update-NextButton })
    $ui.RbRepair.Add_Checked({ $State.Mode = 'repair'; Update-NextButton })
    $ui.RbUninstall.Add_Checked({ $State.Mode = 'uninstall'; Update-NextButton })
    $ui.ChkTrustCa.Add_Checked({ $ui.BtnTrustCa.IsEnabled = (-not $State.CaOk) })
    $ui.ChkTrustCa.Add_Unchecked({ $ui.BtnTrustCa.IsEnabled = $false })

    $ui.BtnTrustCa.Add_Click({
            Invoke-UiAction {
                if ($ui.ChkTrustCa.IsChecked -ne $true) { return }
                $answer = Show-Message ('Trust this branch certificate on this PC?' + "`n`n" + $CaName + "`nSHA-256: " + $CaSha256Display + "`n`n" + 'Click Yes ONLY if this SHA-256 is the same as on the Offline Edge page. / Sirf tab Yes dabayein jab SHA-256 bilkul wohi ho.') 'Confirm the branch certificate' 'YesNo' 'Warning'
                $confirmed = ($ui.ChkTrustCa.IsChecked -eq $true) -and ($answer -eq [System.Windows.MessageBoxResult]::Yes)
                if (-not $confirmed) { return }
                $r = Invoke-CaStep -Confirmed $confirmed
                $State.CaOk = $r.Ok
                if ($r.Ok) {
                    Set-Status $ui.TxtCaStatus ('Trusted: ' + $r.Detail + '. / Certificate trust ho gaya.') 'ok'
                    $ui.BtnTrustCa.IsEnabled = $false
                    $ui.ChkTrustCa.IsEnabled = $false
                }
                Update-NextButton
            }
        })

    $ui.BtnApplyNetwork.Add_Click({
            Invoke-UiAction {
                Set-Status $ui.TxtNetworkResult 'Working ... / Kaam ho raha hai ...' 'info'
                Update-UiNow
                $r = Invoke-NetworkStep
                $State.NetworkOk = $r.Ok
                $kind = 'error'
                if ($r.Ok) { $kind = 'ok' }
                Set-Status $ui.TxtNetworkResult ($r.Lines -join "`n") $kind
                Update-NextButton
            }
        })

    $ui.BtnRunChecks.Add_Click({ Invoke-UiAction { Invoke-CheckRun } })
    $ui.BtnCheckTerminal.Add_Click({ Invoke-UiAction { $State.Health = $null; Invoke-TerminalRun } })

    $ui.BtnSetPin.Add_Click({
            Invoke-UiAction {
                $problem = Test-PinPolicy -Pin $ui.PwPin1.Password -Repeat $ui.PwPin2.Password
                if ($problem) { Set-Status $ui.TxtPinResult $problem 'error'; return }
                Set-Status $ui.TxtPinResult 'Sending your PIN to the Branch Server ... / PIN bheja ja raha hai ...' 'info'
                Update-UiNow
                $r = Invoke-PinEnrollment -Pin $ui.PwPin1.Password
                $ui.PwPin1.Clear()
                $ui.PwPin2.Clear()
                if ($r.Ok) {
                    $State.PinStatus = 'set'
                    $ui.BtnSetPin.IsEnabled = $false
                    Set-Status $ui.TxtPinResult $r.Message 'ok'
                } else {
                    $State.PinStatus = 'failed'
                    Set-Status $ui.TxtPinResult $r.Message 'error'
                }
            }
        })

    $ui.BtnRemove.Add_Click({
            Invoke-UiAction {
                $answer = Show-Message 'Remove Bingoo Offline from this PC? / Kya Bingoo Offline is PC se hatana hai?' 'Remove Bingoo Offline' 'YesNo' 'Question'
                if ($answer -ne [System.Windows.MessageBoxResult]::Yes) { return }
                $removeCa = $false
                if ($ui.ChkRemoveCa.IsChecked -eq $true) {
                    $caAnswer = Show-Message ('Also remove the branch certificate ' + $CaName + '? BINGOO Offline will then show a certificate warning until the setup is run again. / Certificate bhi hatana hai?') 'Remove the branch certificate' 'YesNo' 'Warning'
                    $removeCa = ($ui.ChkRemoveCa.IsChecked -eq $true) -and ($caAnswer -eq [System.Windows.MessageBoxResult]::Yes)
                }
                $r = Invoke-UninstallCore -RemoveCa $removeCa
                $State.Removed = $true
                $State.RemoveResults = $r
                $kind = 'error'
                if ($r.Ok) { $kind = 'ok' }
                Set-Status $ui.TxtRemoveResult ($r.Lines -join "`n") $kind
                $ui.BtnRemove.IsEnabled = $false
                Update-NextButton
            }
        })

    $ui.BtnOpenOffline.Add_Click({ Invoke-UiAction { Start-Process $UrlOffline } })

    $ui.BtnNext.Add_Click({
            Invoke-UiAction {
                $flow = Get-PageFlow
                $i = [Array]::IndexOf($flow, $State.Page)
                if ($i -ge 0 -and $i -lt $flow.Count - 1) { Show-Page $flow[$i + 1] }
            }
        })
    $ui.BtnBack.Add_Click({
            Invoke-UiAction {
                $flow = Get-PageFlow
                $i = [Array]::IndexOf($flow, $State.Page)
                if ($i -gt 0) { Show-Page $flow[$i - 1] }
            }
        })
    $ui.BtnClose.Add_Click({ $Window.Close() })
    $Window.Add_Closing({
            param($source, $closing)
            if ($State.Page -ne 'PageFinish' -and $State.Page -ne 'PageWelcome') {
                $answer = Show-Message 'The setup is not finished. Close anyway? / Setup mukammal nahin hua. Phir bhi band karein?' 'Bingoo Offline Counter' 'YesNo' 'Question'
                if ($answer -ne [System.Windows.MessageBoxResult]::Yes) { $closing.Cancel = $true }
            }
        })
}

# ==== 0. administrator rights (console) =============================================================================

if ($PSCommandPath) {
    try { Unblock-File -LiteralPath $PSCommandPath -ErrorAction Stop } catch { }
}

Write-Host ''
Write-Host ('==== Bingoo Offline Counter - ' + $BranchLabel + ' ====') -ForegroundColor Cyan

if (-not (Test-IsAdministrator)) {
    if ($Elevated) {
        Write-Say 'Windows started this setup again, but it still has no administrator rights. Nothing was changed.' 'Windows ne setup dobara chalaya, lekin administrator ki ijazat phir bhi nahin mili. Kuch bhi tabdeel nahin hua.' 'Red'
        Wait-BeforeClose
        exit 2
    }
    if (-not $PSCommandPath) {
        Write-Say 'Save this file on the PC first, then right-click it and choose "Run with PowerShell".' 'Pehle yeh file PC par save karein, phir us par right-click karke "Run with PowerShell" chunein.' 'Red'
        Wait-BeforeClose
        exit 2
    }
    Write-Say 'This setup needs administrator rights: it trusts the branch certificate and edits the hosts file for ALL users of this PC.' 'Is setup ko administrator ki ijazat chahiye: yeh branch certificate trust karta hai aur is PC ke SAB users ke liye hosts file badalta hai.' 'Yellow'
    Write-Say 'Windows will now ask "Do you want to allow this app to make changes to your device?" - click YES.' 'Ab Windows poochay ga "Do you want to allow this app to make changes to your device?" - YES dabayein.' 'Yellow'
    Write-Say 'If Windows asks for a user name instead, this Windows user is NOT an administrator: ask the shop owner or the IT person to sign in there with an ADMINISTRATOR account. (A POS PIN does not work there.)' 'Agar Windows user name maange, to yeh Windows user administrator NAHIN hai: dukaan ke owner ya IT wale se wahan ADMINISTRATOR account se sign in karwayein. (POS ka PIN wahan kaam nahin karta.)' 'Yellow'
    $argLine = '-NoProfile -STA -ExecutionPolicy Bypass -File "' + $PSCommandPath + '" -Elevated'
    try {
        $child = Start-Process -FilePath 'powershell.exe' -Verb RunAs -ArgumentList $argLine -PassThru -ErrorAction Stop
    } catch {
        Write-Host ''
        Write-Say 'Administrator permission was not given (NO was clicked, or no administrator account was entered). Nothing was changed.' 'Administrator ki ijazat nahin mili (NO dabaya gaya, ya administrator account nahin diya gaya). Kuch bhi tabdeel nahin hua.' 'Red'
        Write-Say 'Run this file again and click YES, or ask the shop owner / IT person to sign in as administrator.' 'Yeh file dobara chalayein aur YES dabayein, ya owner / IT wale se administrator sign in karwayein.' 'Red'
        Wait-BeforeClose
        exit 1
    }
    Write-Say 'The setup window opens now (it may take a few seconds).' 'Setup window ab khul raha hai (kuch second lag sakte hain).' 'Green'
    $childCode = 0
    try { $child.WaitForExit(); $childCode = [int]$child.ExitCode } catch { $childCode = 0 }
    if ($childCode -eq 2) {
        Write-Host ''
        Write-Say 'The setup could not start in the administrator window. If it closed too fast to read, copy this file to the Desktop (not a network drive) and run it again.' 'Administrator window mein setup shuru nahin ho saka. Yeh file Desktop par copy karke (network drive par nahin) dobara chalayein.' 'Red'
        Wait-BeforeClose
    }
    exit $childCode
}

# ==== 1. the window (administrator from here on) ===================================================================

if ([Threading.Thread]::CurrentThread.GetApartmentState() -ne [Threading.ApartmentState]::STA) {
    $child = Start-Process -FilePath 'powershell.exe' -ArgumentList ('-NoProfile -STA -ExecutionPolicy Bypass -File "' + $PSCommandPath + '" -Elevated') -PassThru -Wait
    exit $child.ExitCode
}

try {
    foreach ($assembly in @(
            'PresentationFramework, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35',
            'PresentationCore, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35',
            'WindowsBase, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35',
            'System.Xaml, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089')) {
        [void][System.Reflection.Assembly]::Load($assembly)
    }
    $xamlDoc = [xml]$Xaml
    $Window = [Windows.Markup.XamlReader]::Load((New-Object System.Xml.XmlNodeReader -ArgumentList $xamlDoc))
} catch {
    Write-Say ('The setup window could not be opened: ' + $_.Exception.Message) 'Setup window nahin khul saka.' 'Red'
    Write-Say 'Ask Bingoo support for the classic counter setup file.' 'Bingoo support se classic counter setup file maangein.' 'Red'
    Wait-BeforeClose
    exit 2
}

try {
    Initialize-CounterWindow -XamlDoc $xamlDoc

    Write-CounterLog ('wizard started: ' + $SetupKind + ', branch ' + $BranchLabel + ', branch server ' + $EdgeHost + ' ' + $EdgeIp + ', origin ' + $State.Origin.Status)
    Show-Page 'PageWelcome'
    [void]$Window.ShowDialog()
    Write-CounterLog ('wizard closed: exit ' + $State.ExitCode)
    exit $State.ExitCode
} catch {
    Write-CounterLog ('fatal: ' + $_.Exception.Message)
    Write-Say ('Setup stopped because of an unexpected error: ' + $_.Exception.Message) 'Ek ghalti ki wajah se setup ruk gaya.' 'Red'
    Wait-BeforeClose
    exit 2
}
