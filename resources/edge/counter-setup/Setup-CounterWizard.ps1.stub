# Bingoo POS - OFFLINE COUNTER SETUP (wizard) for: {{BINGOO_BRANCH_LABEL_TEXT}} / {{BINGOO_TENANT_LABEL_TEXT}}
# Generated by the Bingoo Cloud on {{BINGOO_GENERATED_AT}} for the Branch Server {{BINGOO_EDGE_HOST}} ({{BINGOO_EDGE_IP}}, port {{BINGOO_EDGE_PORT}}).
#
# Run it on the cashier PC: right-click this file -> "Run with PowerShell" -> click YES on the Windows prompt.
#   (or in a PowerShell window:  powershell -ExecutionPolicy Bypass -File .\{{BINGOO_FILE_NAME}})
# A window opens and guides you through Install, Repair or Remove. Nothing changes before you click its buttons.
#   - the branch certificate is trusted ONLY after you compare its SHA-256 and confirm it
#   - the hosts file gets ONE line, for {{BINGOO_EDGE_HOST}} only; three desktop shortcuts with the Bingoo icon
#   - the Branch Server is checked by name and by IP with FULL certificate validation (never bypassed)
#   - optional: set YOUR OWN Edge PIN (typed here, sent only to the Branch Server over the verified connection, never saved)
# This file never contacts the internet: after setup the Offline counter needs only the shop network.
#
# Roman Urdu: Is file par right-click -> "Run with PowerShell" -> YES. Window khulega aur har qadam samjhayega.
#   Certificate sirf aap ki tasdeeq ke baad trust hota hai. Aap ka Edge PIN kahin save nahin hota.

param(
    [switch]$Elevated   # set by this script when it starts itself again as administrator
)

$ErrorActionPreference = 'Stop'

# ==== data (generated by the Bingoo Cloud; public addresses, the public certificate, the icon) ======================

$SetupKind       = 'bingoo-counter-wizard-1'
$TenantLabel     = '{{BINGOO_TENANT_LABEL}}'
$BranchLabel     = '{{BINGOO_BRANCH_LABEL}}'
$EdgeIp          = '{{BINGOO_EDGE_IP}}'
$EdgeHost        = '{{BINGOO_EDGE_HOST}}'
$EdgePort        = {{BINGOO_EDGE_PORT}}
$EdgeBaseByName  = '{{BINGOO_EDGE_BASE_BY_NAME}}'
$EdgeBaseByIp    = '{{BINGOO_EDGE_BASE_BY_IP}}'
$HostsLine       = '{{BINGOO_HOSTS_LINE}}'
$LanHint         = '{{BINGOO_LAN_HINT}}'
$UrlOnline       = '{{BINGOO_URL_ONLINE}}'
$UrlOffline      = '{{BINGOO_URL_OFFLINE}}'
$UrlStatus       = '{{BINGOO_URL_STATUS}}'
$ShortcutNames   = @('BINGOO Online', 'BINGOO Offline', 'Branch Server Status')
$CaName          = '{{BINGOO_CA_NAME}}'
$CaThumbprint    = '{{BINGOO_CA_SHA1}}'
$CaSha256        = '{{BINGOO_CA_SHA256}}'
$CaSha256Display = '{{BINGOO_CA_SHA256_DISPLAY}}'
$CaValidUntil    = '{{BINGOO_CA_VALID_UNTIL}}'
$CaPem = @'
{{BINGOO_CA_PEM}}
'@
# The Bingoo logo as a 128 px icon (public branding asset, base64).
$IconB64 = '{{BINGOO_ICON_B64}}'
# The LAN profile exactly as the Bingoo Cloud signed it (canonical JSON, base64) + Ed25519 signature + the Cloud public key.
# Empty = this file was not signed; the wizard then says so and asks you to compare the certificate SHA-256 yourself.
$SignedProfileB64       = '{{BINGOO_SIGNED_PROFILE_B64}}'
$SignedProfileSig       = '{{BINGOO_SIGNED_PROFILE_SIG}}'
$SignedProfileKey       = '{{BINGOO_SIGNED_PROFILE_KEY}}'
$SignedProfileKeySha256 = '{{BINGOO_SIGNED_PROFILE_KEY_SHA256}}'
$SignedProfileKeyId     = '{{BINGOO_SIGNED_PROFILE_KEY_ID}}'
# Optional: the downloading user's OWN one-time Edge enrollment assertion (works once, about 15 minutes). Empty = no PIN page.
$EnrollAssertionB64 = '{{BINGOO_ENROLL_ASSERTION_B64}}'
$EnrollUserLabel    = '{{BINGOO_ENROLL_USER_LABEL}}'
$EnrollExpiresAt    = {{BINGOO_ENROLL_EXPIRES_AT}}
# Optional: the user's default counter (terminal) as a hint. 0 = none.
$TerminalId    = {{BINGOO_TERMINAL_ID}}
$TerminalLabel = '{{BINGOO_TERMINAL_LABEL}}'

$Xaml = @'
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bingoo Offline Counter" Width="800" Height="660" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#FFF6F7F9">
  <Window.Resources>
    <Style x:Key="H1" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="H2" TargetType="TextBlock"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,12,0,4"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="P" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2,0,0"/></Style>
    <Style x:Key="Ur" TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#FF6B7280"/><Setter Property="FontStyle" Value="Italic"/><Setter Property="Margin" Value="0,1,0,10"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#FF6B7280"/><Setter Property="Margin" Value="0,4,14,4"/></Style>
    <Style x:Key="Value" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
    <Style x:Key="Mono" TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,4"/></Style>
    <Style x:Key="Box" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFE5E7EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,6,0,10"/></Style>
    <Style x:Key="Action" TargetType="Button"><Setter Property="Padding" Value="16,6"/><Setter Property="Margin" Value="0,8,0,6"/><Setter Property="HorizontalAlignment" Value="Left"/></Style>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#FF1E3A8A" Padding="18,12">
      <StackPanel Orientation="Horizontal">
        <Image x:Name="Logo" Width="42" Height="42" Margin="0,0,14,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="HeaderTitle" Foreground="White" FontSize="20" FontWeight="SemiBold" Text="Bingoo Offline Counter"/>
          <TextBlock x:Name="HeaderSub" Foreground="#FFDBEAFE" TextWrapping="Wrap"/>
        </StackPanel>
      </StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0" Padding="16,10">
      <DockPanel LastChildFill="False">
        <TextBlock x:Name="StepLabel" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#FF6B7280"/>
        <Button x:Name="BtnClose" DockPanel.Dock="Right" Content="Close" Width="100" Height="30" Margin="8,0,0,0"/>
        <Button x:Name="BtnNext" DockPanel.Dock="Right" Content="Next" Width="100" Height="30" Margin="8,0,0,0" IsDefault="True"/>
        <Button x:Name="BtnBack" DockPanel.Dock="Right" Content="Back" Width="100" Height="30"/>
      </DockPanel>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <Grid Margin="24,16,24,16">

        <StackPanel x:Name="PageWelcome">
          <TextBlock Style="{StaticResource H1}" Text="Set up this PC as a Bingoo Offline counter"/>
          <TextBlock Style="{StaticResource P}" Text="This connects this PC to your shop's Branch Server, so the counter keeps selling when the internet is down. Nothing changes until you click the buttons on the next pages."/>
          <TextBlock Style="{StaticResource Ur}" Text="Yeh setup is PC ko dukaan ke Branch Server se jorta hai, taa ke internet band hone par bhi counter chalta rahe. Agle pages par button dabane se pehle kuch tabdeel nahin hota."/>
          <Border Style="{StaticResource Box}">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource Label}" Text="Business"/>
              <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtTenant" Style="{StaticResource Value}"/>
              <TextBlock Grid.Row="1" Style="{StaticResource Label}" Text="Branch"/>
              <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtBranch" Style="{StaticResource Value}"/>
              <TextBlock Grid.Row="2" Style="{StaticResource Label}" Text="Branch Server"/>
              <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtServer" Style="{StaticResource Value}"/>
              <TextBlock Grid.Row="3" Style="{StaticResource Label}" Text="IP address"/>
              <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtServerIp" Style="{StaticResource Value}"/>
              <TextBlock Grid.Row="4" Style="{StaticResource Label}" Text="Certificate SHA-256"/>
              <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtWelcomeSha" Style="{StaticResource Mono}"/>
            </Grid>
          </Border>
          <TextBlock x:Name="TxtOrigin" Style="{StaticResource P}" FontWeight="SemiBold"/>
          <TextBlock x:Name="TxtSetupState" Style="{StaticResource P}" Margin="0,8,0,0"/>
          <TextBlock Style="{StaticResource H2}" Text="What do you want to do?  /  Aap kya karna chahte hain?"/>
          <RadioButton x:Name="RbInstall" GroupName="Mode" Margin="0,4"><TextBlock TextWrapping="Wrap" Text="Install - set up this counter (Install - is counter ko set up karein)"/></RadioButton>
          <RadioButton x:Name="RbRepair" GroupName="Mode" Margin="0,4"><TextBlock TextWrapping="Wrap" Text="Repair - apply everything again: after a Windows problem, a deleted shortcut, or a NEW Branch Server address"/></RadioButton>
          <TextBlock Style="{StaticResource Ur}" Margin="22,0,0,4" Text="New address? First download a NEW setup file from the Online POS (menu: Install Offline Counter), then run it and choose Repair. / Naya address? Pehle Online POS se NAYI setup file download karein, phir usay chala kar Repair chunein."/>
          <RadioButton x:Name="RbUninstall" GroupName="Mode" Margin="0,4"><TextBlock TextWrapping="Wrap" Text="Remove - take Bingoo Offline off this PC (Hatayein)"/></RadioButton>
        </StackPanel>

        <StackPanel x:Name="PageCa" Visibility="Collapsed">
          <TextBlock Style="{StaticResource H1}" Text="Trust your shop's branch certificate"/>
          <TextBlock Style="{StaticResource P}" Text="The Branch Server proves it is genuine with this certificate. Compare the SHA-256 below with the one on the Offline Edge page (Settings, Offline Edge) or on the Branch Server Status page, or ask your manager. Trust it ONLY if they are the same."/>
          <TextBlock Style="{StaticResource Ur}" Text="Branch Server is certificate se apni pehchaan saabit karta hai. Neeche wala SHA-256 Offline Edge page ya manager se milayein. Sirf tab trust karein jab dono bilkul ek jaise hon."/>
          <Border Style="{StaticResource Box}">
            <StackPanel>
              <TextBlock Style="{StaticResource Label}" Text="Certificate"/>
              <TextBlock x:Name="TxtCaName" Style="{StaticResource Value}"/>
              <TextBlock Style="{StaticResource Label}" Text="SHA-256"/>
              <TextBlock x:Name="TxtCaSha" Style="{StaticResource Mono}" FontSize="14"/>
              <TextBlock Style="{StaticResource Label}" Text="Valid until"/>
              <TextBlock x:Name="TxtCaValid" Style="{StaticResource Value}"/>
            </StackPanel>
          </Border>
          <TextBlock x:Name="TxtCaStatus" Style="{StaticResource P}" FontWeight="SemiBold"/>
          <CheckBox x:Name="ChkTrustCa" Margin="0,12,0,2"><TextBlock TextWrapping="Wrap" Text="I compared the SHA-256 and it is the same. I want this PC to trust this certificate."/></CheckBox>
          <TextBlock Style="{StaticResource Ur}" Margin="22,0,0,4" Text="Main ne SHA-256 mila liya hai, yeh wohi hai. Main chahta hoon ke yeh PC is certificate ko trust kare."/>
          <Button x:Name="BtnTrustCa" Style="{StaticResource Action}" Content="Trust this certificate" IsEnabled="False"/>
        </StackPanel>

        <StackPanel x:Name="PageNetwork" Visibility="Collapsed">
          <TextBlock Style="{StaticResource H1}" Text="Branch Server name and desktop shortcuts"/>
          <TextBlock Style="{StaticResource P}" Text="This adds ONE line to the Windows hosts file, only for the Branch Server name, and puts three shortcuts with the Bingoo icon on the desktop of every user of this PC."/>
          <TextBlock Style="{StaticResource Ur}" Text="Hosts file mein sirf Branch Server ke naam ki EK line likhi jayegi, aur is PC ke har user ke desktop par Bingoo icon wale teen shortcuts banenge."/>
          <Border Style="{StaticResource Box}">
            <StackPanel>
              <TextBlock Style="{StaticResource Label}" Text="Hosts line"/>
              <TextBlock x:Name="TxtHostsLine" Style="{StaticResource Mono}"/>
              <TextBlock Style="{StaticResource Label}" Text="Shortcuts"/>
              <TextBlock x:Name="TxtShortcutOnline" Style="{StaticResource P}"/>
              <TextBlock x:Name="TxtShortcutOffline" Style="{StaticResource P}"/>
              <TextBlock x:Name="TxtShortcutStatus" Style="{StaticResource P}"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnApplyNetwork" Style="{StaticResource Action}" Content="Add the hosts line and shortcuts"/>
          <TextBlock x:Name="TxtNetworkResult" Style="{StaticResource P}"/>
        </StackPanel>

        <StackPanel x:Name="PageCheck" Visibility="Collapsed">
          <TextBlock Style="{StaticResource H1}" Text="Check the secure connection"/>
          <TextBlock Style="{StaticResource P}" Text="The Branch Server is checked by its name and by its IP address, with full certificate validation, and its Offline login page is opened."/>
          <TextBlock Style="{StaticResource Ur}" Text="Branch Server ko naam aur IP dono se, poori certificate jaanch ke saath check kiya ja raha hai, aur Offline login page khola ja raha hai."/>
          <Border Style="{StaticResource Box}"><TextBlock x:Name="TxtCheckResult" Style="{StaticResource Mono}"/></Border>
          <TextBlock x:Name="TxtCheckHint" Style="{StaticResource P}"/>
          <Button x:Name="BtnRunChecks" Style="{StaticResource Action}" Content="Check again"/>
        </StackPanel>

        <StackPanel x:Name="PagePin" Visibility="Collapsed">
          <TextBlock Style="{StaticResource H1}" Text="Set my Edge PIN (optional)"/>
          <TextBlock Style="{StaticResource P}" Text="Your Offline login is your employee code plus an Edge PIN. Type a new PIN twice. It goes only to your Branch Server over the verified connection and is never saved on this PC."/>
          <TextBlock Style="{StaticResource Ur}" Text="Offline login = employee code + Edge PIN. Naya PIN do dafa likhein. Yeh sirf aap ke Branch Server ko jaata hai aur is PC par kabhi save nahin hota."/>
          <Border Style="{StaticResource Box}">
            <StackPanel>
              <TextBlock x:Name="TxtPinWho" Style="{StaticResource Value}"/>
              <TextBlock x:Name="TxtPinExpiry" Style="{StaticResource P}" Foreground="#FF6B7280"/>
              <TextBlock Style="{StaticResource Label}" Text="New PIN (6 to 12 digits)"/>
              <PasswordBox x:Name="PwPin1" Width="220" MaxLength="12" HorizontalAlignment="Left" FontSize="16"/>
              <TextBlock Style="{StaticResource Label}" Text="Type the PIN again"/>
              <PasswordBox x:Name="PwPin2" Width="220" MaxLength="12" HorizontalAlignment="Left" FontSize="16"/>
            </StackPanel>
          </Border>
          <Button x:Name="BtnSetPin" Style="{StaticResource Action}" Content="Set my Edge PIN"/>
          <TextBlock x:Name="TxtPinResult" Style="{StaticResource P}"/>
          <TextBlock Style="{StaticResource Ur}" Margin="0,10,0,0" Text="You can skip this page with Next; your manager can set your PIN instead. / Yeh page Next se chhor sakte hain; manager bhi PIN set kar sakta hai."/>
        </StackPanel>

        <StackPanel x:Name="PageTerminal" Visibility="Collapsed">
          <TextBlock Style="{StaticResource H1}" Text="Your counter"/>
          <TextBlock Style="{StaticResource P}" Text="This is the counter (terminal) your user normally sells on. The Branch Server is asked whether it knows that counter."/>
          <TextBlock Style="{StaticResource Ur}" Text="Yeh woh counter (terminal) hai jis par aap aam tor par sale karte hain. Branch Server se poocha ja raha hai ke woh is counter ko jaanta hai."/>
          <Border Style="{StaticResource Box}"><TextBlock x:Name="TxtTerminalHint" Style="{StaticResource Value}"/></Border>
          <TextBlock x:Name="TxtTerminalStatus" Style="{StaticResource P}"/>
          <Button x:Name="BtnCheckTerminal" Style="{StaticResource Action}" Content="Check again"/>
        </StackPanel>

        <StackPanel x:Name="PageRemove" Visibility="Collapsed">
          <TextBlock Style="{StaticResource H1}" Text="Remove Bingoo Offline from this PC"/>
          <TextBlock Style="{StaticResource P}" Text="This removes what the setup added. The Online POS keeps working in Chrome."/>
          <TextBlock Style="{StaticResource Ur}" Text="Yeh woh sab hata deta hai jo setup ne lagaya tha. Online POS Chrome mein chalta rahega."/>
          <Border Style="{StaticResource Box}"><TextBlock x:Name="TxtRemoveList" Style="{StaticResource P}"/></Border>
          <CheckBox x:Name="ChkRemoveCa" Margin="0,8,0,2"><TextBlock TextWrapping="Wrap" Text="Also remove the branch certificate (asks again before removing)"/></CheckBox>
          <TextBlock x:Name="TxtRemoveCaNote" Style="{StaticResource Ur}" Margin="22,0,0,4"/>
          <Button x:Name="BtnRemove" Style="{StaticResource Action}" Content="Remove"/>
