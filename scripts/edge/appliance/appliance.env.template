# Bingoo Edge — Branch Server appliance configuration TEMPLATE (P4 §7).
# The installer copies this to <DataRoot>\config\appliance.env and fills the values; the file is the ONLY place a
# secret lives on the appliance (ACL: the service account + local Administrators; never world-readable). Nothing in
# this template carries a value: a package never ships a secret. Keys marked (secret) are never printed or logged.

# ── Runtime role (a packaged artifact REFUSES to run as anything but branch_server) ──────────────────────────
APP_ROLE=branch_server
APP_ENV=production
APP_DEBUG=false
APP_URL=https://bingoo-edge.local
APP_TIMEZONE=Asia/Karachi
LOG_CHANNEL=edge
LOG_LEVEL=info
EDGE_LOG_PATH=
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# ── Appliance layout (paths only) ─────────────────────────────────────────────────────────────────────────────
EDGE_DATA_ROOT=
EDGE_UPDATE_INSTALL_ROOT=
EDGE_BACKUP_PATH=
EDGE_BACKUP_RETENTION=24

# ── Machine-local application key (secret; generated by the installer — NEVER the Cloud APP_KEY) ─────────────
EDGE_LOCAL_APP_KEY=

# ── Local database (loopback only; a dedicated bingoo_edge_* database; credentials are secret) ──────────────
EDGE_DB_HOST=127.0.0.1
EDGE_DB_PORT=3306
EDGE_DB_DATABASE=bingoo_edge_local
EDGE_DB_USERNAME=
EDGE_DB_PASSWORD=
# The Cloud master connection is NOT configured on an appliance (no DB_* keys on purpose).

# ── Device identity + Cloud endpoints (written by `edge:local:pair`; the secret is generated locally) ─────────
EDGE_CLOUD_BASE_URL=
EDGE_INSTALLATION_UUID=
EDGE_SYNC_DEVICE_ID=
EDGE_SYNC_DEVICE_SECRET=
EDGE_SYNC_URL=
EDGE_SYNC_RETURNS_URL=
EDGE_SYNC_SUPPLIER_FINANCE_URL=
EDGE_SYNC_PURCHASE_RETURNS_URL=
EDGE_SYNC_RECONCILE_URL=
EDGE_SYNC_BASELINE_URL=
EDGE_STANDBY_CONFIG_REFRESH_URL=
EDGE_STANDBY_RETURNABLE_REFRESH_URL=
EDGE_STANDBY_SUPPLIER_FINANCE_REFRESH_URL=
EDGE_STANDBY_PURCHASE_RETURN_REFRESH_URL=
EDGE_AUTHORITY_HEARTBEAT_URL=
EDGE_AUTHORITY_HANDBACK_URL=
EDGE_SYNC_CONNECT_TIMEOUT=10
EDGE_SYNC_TIMEOUT=20

# ── Authority lease (supervised takeover ONLY — automatic failover is never enabled) ─────────────────────────
EDGE_AUTHORITY_TTL=120
EDGE_AUTHORITY_SKEW_MARGIN=30
EDGE_AUTHORITY_INTERVAL=20
EDGE_AUTHORITY_REQUIRE_CONFIRMATION=true

# ── Trust keys (public keys only on the appliance; the Cloud/build host holds the private ones) ──────────────
EDGE_ENROLLMENT_PUBLIC_KEY=
EDGE_UPDATE_PUBLIC_KEY=
EDGE_UPDATE_ALLOW_DOWNGRADE=false

# ── Backup recovery key (secret; provisioned per branch from the Cloud recovery authority; base64 of 32 bytes) ─
EDGE_BACKUP_RECOVERY_KEY=
EDGE_BACKUP_RECOVERY_KEY_ID=k1
EDGE_BACKUP_RETIRED_KEYS={}

# ── Web runtime + TLS gateway ────────────────────────────────────────────────────────────────────────────────
EDGE_WEB_BIND=127.0.0.1
EDGE_WEB_PORT_BASE=8090
EDGE_WEB_WORKERS=2
EDGE_GATEWAY_HTTPS_PORT=443
EDGE_GATEWAY_HTTP_PORT=80

# ── LAN name contract (DHCP-reserved IP + hosts-file / router DNS) ───────────────────────────────────────────
EDGE_LAN_HOSTNAME=bingoo-edge.local
EDGE_LAN_IP=
EDGE_LAN_NAME_MECHANISM=hosts_file
